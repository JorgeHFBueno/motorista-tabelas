rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function getRole() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function getUserRole(uid) {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(uid)).data.role
        : null;
    }

    function isStaff() {
      return getRole() in ['admin', 'gerente', 'operacional'];
    }

    function isStaffUser(uid) {
      return getUserRole(uid) in ['admin', 'gerente', 'operacional'];
    }

    function supportTicketPath(ticketId) {
      return /databases/$(database)/documents/suporteTickets/$(ticketId);
    }

    function canReadSupportTicketData(ticketData) {
      return isStaff() || isSelf(ticketData.clienteUid);
    }

    function isSupportNotificationType() {
      return request.resource.data.tipo in [
        'suporte_ticket_novo',
        'suporte_ticket_resposta',
        'suporte_ticket_status',
      ];
    }

    function isClientNotificationReadUpdate(uid) {
      return isSelf(uid)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['lida'])
        && request.resource.data.lida is bool;
    }

    function isObraUpdateWithoutExecucaoEquipeChange() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['execucaoEquipe']);
    }

    function isSupportNotificationCreate(uid) {
      return isSignedIn()
        && request.resource.data.userId == uid
        && request.resource.data.origemColecao == 'suporteTickets'
        && request.resource.data.origemId is string
        && exists(supportTicketPath(request.resource.data.origemId))
        && isSupportNotificationType()
        && (
          (isStaff() && get(supportTicketPath(request.resource.data.origemId)).data.clienteUid == uid)
          || (
            request.auth.uid == get(supportTicketPath(request.resource.data.origemId)).data.clienteUid
            && isStaffUser(uid)
          )
        );
    }

    function isPublishedNewsRead() {
      return resource.data.status == 'publicada';
    }

    function isInstitutionalNewsCreate() {
      return isStaff()
        && request.resource.data.categoria == 'institucional'
        && request.resource.data.origem == 'institucional';
    }

    function isInstitutionalNewsUpdate() {
      return isStaff()
        && resource.data.categoria == 'institucional'
        && resource.data.origem == 'institucional'
        && request.resource.data.categoria == 'institucional'
        && request.resource.data.origem == 'institucional';
    }

    function isInstitutionalNewsDelete() {
      return isStaff()
        && resource.data.categoria == 'institucional'
        && resource.data.origem == 'institucional';
    }

    function isOwnSupportTicketCreate() {
      return isSignedIn()
        && !isStaff()
        && request.resource.data.clienteUid == request.auth.uid
        && request.resource.data.criadoPorTipo == 'cliente'
        && request.resource.data.ultimaMensagemPorTipo == 'cliente'
        && request.resource.data.naoLidasCliente == 0
        && request.resource.data.naoLidasAdmin is int
        && request.resource.data.status == 'aberto';
    }

    function isClientSupportTicketUpdate() {
      return isSignedIn()
        && resource.data.clienteUid == request.auth.uid
        && resource.data.status != 'fechado'
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'status',
          'atualizadoEm',
          'ultimaMensagemResumo',
          'ultimaMensagemEm',
          'ultimaMensagemPorTipo',
          'naoLidasCliente',
          'naoLidasAdmin',
        ])
        && request.resource.data.clienteUid == resource.data.clienteUid
        && request.resource.data.clienteNome == resource.data.clienteNome
        && request.resource.data.clienteEmail == resource.data.clienteEmail
        && request.resource.data.obraId == resource.data.obraId
        && request.resource.data.obraNome == resource.data.obraNome
        && request.resource.data.titulo == resource.data.titulo
        && request.resource.data.descricaoInicial == resource.data.descricaoInicial
        && request.resource.data.categoria == resource.data.categoria
        && request.resource.data.prioridade == resource.data.prioridade
        && request.resource.data.criadoPorTipo == resource.data.criadoPorTipo
        && request.resource.data.criadoEm == resource.data.criadoEm
        && request.resource.data.responsavelUid == resource.data.responsavelUid
        && request.resource.data.responsavelNome == resource.data.responsavelNome
        && request.resource.data.naoLidasCliente == 0
        && request.resource.data.naoLidasAdmin >= resource.data.naoLidasAdmin
        && (
          request.resource.data.status == resource.data.status
          || request.resource.data.status == 'em_andamento'
        )
        && (
          request.resource.data.ultimaMensagemPorTipo == resource.data.ultimaMensagemPorTipo
          || request.resource.data.ultimaMensagemPorTipo == 'cliente'
        );
    }

    function canReadSupportTicket(ticketId) {
      return exists(supportTicketPath(ticketId))
        && canReadSupportTicketData(get(supportTicketPath(ticketId)).data);
    }

    function isClientSupportMessageCreate(ticketId) {
      return exists(supportTicketPath(ticketId))
        && get(supportTicketPath(ticketId)).data.clienteUid == request.auth.uid
        && get(supportTicketPath(ticketId)).data.status != 'fechado'
        && request.resource.data.autorUid == request.auth.uid
        && request.resource.data.autorTipo == 'cliente'
        && request.resource.data.mensagem is string;
    }

    function isStaffSupportMessageCreate(ticketId) {
      return exists(supportTicketPath(ticketId))
        && isStaff()
        && get(supportTicketPath(ticketId)).data.status != 'fechado'
        && request.resource.data.autorUid == request.auth.uid
        && request.resource.data.autorTipo == 'admin'
        && request.resource.data.mensagem is string;
    }

    match /users/{uid}/notificacoes/{notificacaoId} {
      allow read: if isSelf(uid);
      allow create: if isSupportNotificationCreate(uid);
      allow delete: if false;
      allow update: if isClientNotificationReadUpdate(uid);
    }

    match /users/{uid} {
      allow read, write: if isSignedIn();
    }

    match /suporteTickets/{ticketId} {
      allow read: if canReadSupportTicketData(resource.data);
      allow create: if isOwnSupportTicketCreate() || isStaff();
      allow update: if isStaff() || isClientSupportTicketUpdate();
      allow delete: if false;

      match /mensagens/{mensagemId} {
        allow read: if canReadSupportTicket(ticketId);
        allow create: if isClientSupportMessageCreate(ticketId) || isStaffSupportMessageCreate(ticketId);
        allow update, delete: if false;
      }
    }

    match /obras/{obraId} {
      allow read, create, delete: if isSignedIn();
      allow update: if isSignedIn()
        && (isStaff() || isObraUpdateWithoutExecucaoEquipeChange());
      match /{sub=**} {
        allow read, write: if isSignedIn();
      }
    }

    match /documentos/{docId} {
      allow read, write: if isSignedIn();
      match /{sub=**} {
        allow read, write: if isSignedIn();
      }
    }

    match /fotos/{fotoId} {
      allow read, write: if isSignedIn();
    }

    match /financeiroParcelas/{parcelaId} {
      allow read, write: if isSignedIn();
    }

    match /documentos-lixo/{docId} {
      allow read, write: if isSignedIn();
    }

    match /fotos-lixo/{fotoId} {
      allow read, write: if isSignedIn();
    }

    match /noticias/{noticiaId} {
      allow read: if isSignedIn() && (isPublishedNewsRead() || isStaff());
      allow create: if isInstitutionalNewsCreate();
      allow update: if isInstitutionalNewsUpdate();
      allow delete: if isInstitutionalNewsDelete();
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function getRole() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isStaff() {
      return getRole() in ['admin', 'gerente', 'operacional'];
    }

    function isClientNotificationReadUpdate(uid) {
      return isSelf(uid)
        && request.resource.data.diff(resource.data).changedKeys().hasOnly(['lida'])
        && request.resource.data.lida is bool;
    }

    function isPublishedNewsRead() {
      return resource.data.status == 'publicada';
    }

    function isInstitutionalNewsCreate() {
      return isStaff()
        && request.resource.data.categoria == 'institucional'
        && request.resource.data.origem == 'institucional';
    }

    function isInstitutionalNewsUpdate() {
      return isStaff()
        && resource.data.categoria == 'institucional'
        && resource.data.origem == 'institucional'
        && request.resource.data.categoria == 'institucional'
        && request.resource.data.origem == 'institucional';
    }

    function isInstitutionalNewsDelete() {
      return isStaff()
        && resource.data.categoria == 'institucional'
        && resource.data.origem == 'institucional';
    }

    match /users/{uid}/notificacoes/{notificacaoId} {
      allow read: if isSelf(uid);
      allow create, delete: if false;
      allow update: if isClientNotificationReadUpdate(uid);
    }

    match /users/{uid} {
      allow read, write: if isSignedIn();
    }
    match /obras/{obraId} {
      allow read, write: if isSignedIn();
      match /{sub=**} {
        allow read, write: if isSignedIn();
      }
    }

    match /documentos/{docId} {
      allow read, write: if isSignedIn();
      match /{sub=**} {
        allow read, write: if isSignedIn();
      }
    }

    match /fotos/{fotoId} {
      allow read, write: if isSignedIn();
    }

    match /financeiroParcelas/{parcelaId} {
      allow read, write: if isSignedIn();
    }

    match /documentos-lixo/{docId} {
      allow read, write: if isSignedIn();
    }

    match /fotos-lixo/{fotoId} {
      allow read, write: if isSignedIn();
    }

    match /noticias/{noticiaId} {
      allow read: if isSignedIn() && (isPublishedNewsRead() || isStaff());
      allow create: if isInstitutionalNewsCreate();
      allow update: if isInstitutionalNewsUpdate();
      allow delete: if isInstitutionalNewsDelete();
    }
  }
}

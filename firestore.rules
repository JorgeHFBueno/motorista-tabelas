rules_version='2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function userDoc() {
      return get(userPath(request.auth.uid)).data;
    }

    function role() {
      return userDoc().role;
    }

    function isStaff() {
      return isSignedIn() && role() != "cliente";
    }

    function isClient() {
      return isSignedIn() && role() == "cliente";
    }

    function isAdmin() {
      return isSignedIn() && role() == "admin";
    }

    function hasObra(obraId) {
      return isSignedIn()
        && (obraId is string)
        && (obraId != "")
        && ('obras' in userDoc())
        && (userDoc().obras is list)
        && (obraId in userDoc().obras);
    }

    function legacyHasObra() {
      return isSignedIn()
        && ('obraId' in resource.data)
        && (resource.data.obraId is string)
        && (resource.data.obraId != "")
        && hasObra(resource.data.obraId);
    }

    function isValidNewUser() {
      return request.resource.data.keys().hasOnly([
          'nome',
          'tipo',
          'role',
          'obras',
          'ativo',
          'createdAt'
        ])
        && request.resource.data.keys().hasAll([
          'nome',
          'tipo',
          'role',
          'ativo',
          'createdAt'
        ])
        && request.resource.data.nome is string
        && request.resource.data.tipo == 'cliente'
        && request.resource.data.role == 'cliente'
        && request.resource.data.ativo == true
        && request.resource.data.createdAt is timestamp
        && (
          !('obras' in request.resource.data)
          || (
            request.resource.data.obras is list
            && request.resource.data.obras.size() == 0
          )
        );
    }

    function isValidUserUpdate() {
      return request.resource.data.diff(resource.data).changedKeys().hasOnly(['nome'])
        && request.resource.data.nome is string
        && request.resource.data.tipo == resource.data.tipo
        && request.resource.data.role == resource.data.role
        && request.resource.data.ativo == resource.data.ativo
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.obras == resource.data.obras;
    }

    function isValidAccessRequestCreate() {
      return request.resource.data.keys().hasOnly([
          'uid',
          'nomeSnapshot',
          'emailSnapshot',
          'createdAt',
          'status',
          'observacao'
        ])
        && request.resource.data.keys().hasAll([
          'uid',
          'nomeSnapshot',
          'emailSnapshot',
          'createdAt',
          'status'
        ])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nomeSnapshot is string
        && request.resource.data.emailSnapshot is string
        && request.resource.data.createdAt is timestamp
        && request.resource.data.status == 'pendente'
        && (
          !('observacao' in request.resource.data)
          || request.resource.data.observacao is string
        );
    }

    function obraIdMatchesIfPresent(obraId) {
      return !('obraId' in request.resource.data) || request.resource.data.obraId == obraId;
    }

    function validDocumentoWrite(obraId) {
      return request.resource.data.createdAt is timestamp
        && request.resource.data.storagePath is string
        && request.resource.data.contentType is string
        && (
          ('nome' in request.resource.data && request.resource.data.nome is string)
          || ('filename' in request.resource.data && request.resource.data.filename is string)
        )
        && obraIdMatchesIfPresent(obraId);
    }

    function canReadDocumentos(obraId) {
      return isAdmin() || (obraId is string && obraId != "" && hasObra(obraId)) || (obraId == null && isSignedIn());
    }

    function canWriteDocumentos(obraId) {
      return isAdmin() || (obraId is string && obraId != "" && hasObra(obraId));
    }

    function validFotoWrite(obraId) {
      return request.resource.data.createdAt is timestamp
        && request.resource.data.storagePath is string
      && request.resource.data.contentType is string
      && obraIdMatchesIfPresent(obraId);
    }

    function validFinancaWrite(obraId) {
      return request.resource.data.createdAt is timestamp
        && request.resource.data.valor is number
        && request.resource.data.descricao is string
        && obraIdMatchesIfPresent(obraId);
    }

    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid && isValidNewUser();
      allow update: if isSignedIn() && request.auth.uid == uid && isValidUserUpdate();
      allow delete: if false;

      match /accessRequests/{requestId} {
        allow get, list: if isSignedIn() && request.auth.uid == uid;
        allow create: if isSignedIn() && request.auth.uid == uid && isValidAccessRequestCreate();
        allow update, delete: if false;
      }
    }

    match /obras/{obraId} {
      allow read: if isAdmin() || hasObra(obraId);
      allow write: if false;

      match /documentos/{docId} {
        allow read: if isAdmin() || hasObra(obraId);
        allow create, update: if (isAdmin() || hasObra(obraId)) && validDocumentoWrite(obraId);
        allow delete: if isAdmin() || hasObra(obraId);
      }

      match /fotos/{fotoId} {
        allow read: if isAdmin() || hasObra(obraId);
        allow create, update: if (isAdmin() || hasObra(obraId)) && validFotoWrite(obraId);
        allow delete: if isAdmin() || hasObra(obraId);
      }

      match /financas/{itemId} {
        allow read: if isAdmin() || hasObra(obraId);
        allow create, update: if (isAdmin() || (hasObra(obraId) && !isClient())) && validFinancaWrite(obraId);
        allow delete: if isAdmin() || (hasObra(obraId) && !isClient());
      }
    }

    match /documentos/{docId} {
      allow read: if canReadDocumentos(resource.data.obraId);
      allow create: if canWriteDocumentos(request.resource.data.obraId);
      allow update: if canWriteDocumentos(resource.data.obraId);
      allow delete: if canWriteDocumentos(resource.data.obraId);

      match /auditoria/{eventId} {
        allow read: if canReadDocumentos(get(/databases/$(database)/documents/documentos/$(docId)).data.obraId);
        allow create: if canWriteDocumentos(get(/databases/$(database)/documents/documentos/$(docId)).data.obraId);
        allow update, delete: if false;
      }

      match /versoes/{versionId} {
        allow read: if canReadDocumentos(get(/databases/$(database)/documents/documentos/$(docId)).data.obraId);
        allow create, update, delete: if canWriteDocumentos(get(/databases/$(database)/documents/documentos/$(docId)).data.obraId);
      }

      match /assinaturas/{signatureId} {
        allow read: if canReadDocumentos(get(/databases/$(database)/documents/documentos/$(docId)).data.obraId);
        allow create, update, delete: if canWriteDocumentos(get(/databases/$(database)/documents/documentos/$(docId)).data.obraId);
      }
    }

    match /fotos/{fotoId} {
      allow get: if legacyHasObra();
      allow list: if false;
      allow write: if false;
    }

    match /financas/{itemId} {
      allow get: if legacyHasObra();
      allow list: if false;
      allow write: if false;
    }

    match /accessRequests/{requestId} {
      allow read, write: if false;
    }
  }
}

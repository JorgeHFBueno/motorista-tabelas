rules_version = '2';

// Fonte única das Rules do projeto app-motor-api (WEB, app Flutter e Kiosk). O contrato por coleção está no
// Manuscript (01_FIRESTORE/03_RULES.md). Não publicar sem a revisão do app Flutter.
service cloud.firestore {
  match /databases/{database}/documents {

    // Authentication and authorization profiles.
    function signedIn() {
      return request.auth != null;
    }

    function employeeExists() {
      return signedIn()
        && exists(
          /databases/$(database)/documents/funcionarios/$(request.auth.uid)
        );
    }

    function employee() {
      return get(
        /databases/$(database)/documents/funcionarios/$(request.auth.uid)
      ).data;
    }

    // funcionarios/{uid} is the only identity. 00-autorizados (legacy) no longer authorizes anything.
    function isAuthorized() {
      return employeeExists()
        && employee().get('ativo', false) == true;
    }

    function hasPerfil(perfil) {
      return isAuthorized()
        && employee().get('perfis', {}).get(perfil, false) == true;
    }

    // Independent credentials (Manuscript funcionarios.md, "Credenciais"): each flow checks its own; adm2 enters all.
    function isAdm2() {
      return hasPerfil('adm2');
    }

    // WEB area open to adm2 and to up to two credentials (repeat the key to use only one); one read of the profile.
    function temArea(a, b) {
      let perfis = isAuthorized() ? employee().get('perfis', {}) : {};
      return perfis.get('adm2', false) == true || perfis.get(a, false) == true || perfis.get(b, false) == true;
    }

    // Client portal, team side (WEB /portal-cliente): engenharia, escritorio or adm2.
    function isEquipePortal() {
      return temArea('engenharia', 'escritorio');
    }

    // WEB Frota (/frota/*): mecanico, logistica or adm2.
    function isFrota() {
      return temArea('mecanico', 'logistica');
    }

    // WEB Bombas and Logística: logistica, mecanico or adm2 (Combustível, logistica only, is temArea('logistica', 'logistica')).
    function isLogistica() {
      return temArea('logistica', 'mecanico');
    }

    // WEB Engenharia (/engenharia/*): engenharia or adm2.
    function isEngenharia() {
      return temArea('engenharia', 'engenharia');
    }

    // Who picks people from funcionarios (the whole document comes back): app pickers (frentista, mecanico, Kiosk),
    // Friday (escritorio), Combustível/Frota/Bombas/Logística (logistica, mecanico) and adm2. Not motorista,
    // engenharia, autor or retr0 alone.
    function lePessoas() {
      let perfis = isAuthorized() ? employee().get('perfis', {}) : {};
      return perfis.get('adm2', false) == true
        || perfis.get('frentista', false) == true
        || perfis.get('mecanico', false) == true
        || perfis.get('escritorio', false) == true
        || perfis.get('logistica', false) == true;
    }

    // Activity of the signed-in person: driver or author, in any of the shapes the app queries (Histórico). Direct
    // field access on purpose: a missing field or another shape is an error absorbed by ||, and each app query
    // (equality on one of these fields) is provable.
    function atividadeDoProprio(data) {
      return data.motorista.uid == request.auth.uid
        || data.motorista == request.auth.uid
        || data.motoristaUid == request.auth.uid
        || data.criadoPor.uid == request.auth.uid
        || data.criadoPorUid == request.auth.uid;
    }

    // Fuel record of the signed-in person (app Histórico: frentista, motorista/operador or author; legacy uid and
    // motoristaUid).
    function combustivelDoProprio(data) {
      return data.frentista.uid == request.auth.uid
        || data.motoristaOperador.uid == request.auth.uid
        || data.criadoPor.uid == request.auth.uid
        || data.motoristaUid == request.auth.uid
        || data.uid == request.auth.uid;
    }

    function isFrentista() {
      return hasPerfil('frentista');
    }

    function isMecanico() {
      return hasPerfil('mecanico');
    }

    // The signed-in employee holds one of two credentials (one read of the profile; keeps big rules under the limits).
    function hasEitherPerfil(a, b) {
      let perfis = isAuthorized() ? employee().get('perfis', {}) : {};
      return perfis.get(a, false) == true || perfis.get(b, false) == true;
    }

    // Another active employee holding a credential (e.g. the driver chosen for someone else's Saída).
    function employeeHasCredential(uid, credencial) {
      let outro = nonEmptyString(uid) && exists(/databases/$(database)/documents/funcionarios/$(uid))
        ? get(/databases/$(database)/documents/funcionarios/$(uid)).data
        : {};
      return outro.get('ativo', false) == true
        && outro.get('perfis', {}).get(credencial, false) == true;
    }

    function hasAdminClaim() {
      return isAuthorized()
        && request.auth.token.get('admin', false) == true;
    }

    function changedOnly(fields) {
      return request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly(fields);
    }

    function didNotChange(fields) {
      return !request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasAny(fields);
    }

    function nonEmptyString(value) {
      return value is string && value != '';
    }

    // ---------------------------------------------------------------- activities (Saída/Chegada)
    function isMigratedVehicleActivity() {
      return (
          request.resource.data.get('tipo', '') == 'saida'
          || request.resource.data.get('tipo', '') == 'chegada'
        )
        && request.resource.data.get('motorista', null) is map
        && request.resource.data.get('criadoPor', null) is map;
    }

    function hasMigratedDriverSnapshot() {
      return request.resource.data.get('motorista', {}) is map
        && nonEmptyString(request.resource.data.get('motorista', {}).get('uid', ''))
        && nonEmptyString(request.resource.data.get('motorista', {}).get('nome', ''));
    }

    function hasMigratedAuthorSnapshot() {
      return request.resource.data.get('criadoPor', {}) is map
        && nonEmptyString(request.resource.data.get('criadoPor', {}).get('uid', ''))
        && nonEmptyString(request.resource.data.get('criadoPor', {}).get('nome', ''))
        && request.resource.data.get('criadoPor', {}).get('uid', '') == request.auth.uid;
    }

    // Policy (2026-10-26): the Rules check who may write, authorship and the IDs that are referenced, and keep numbers
    // as integers. The document format (versions, fixed values, names copied from the registries, sums) is the
    // contract in the Manuscript, checked by the app and flagged by the WEB, so app changes do not need Rules changes.

    // An existing veiculos-v2 item, by ID (the snapshot copied next to it is not compared).
    function fleetItemExists(itemId) {
      return nonEmptyString(itemId)
        && exists(/databases/$(database)/documents/veiculos-v2/$(itemId));
    }

    // Saída/Chegada V2 references an existing veiculos-v2 item.
    function validItemFrotaSnapshot() {
      return fleetItemExists(request.resource.data.get('item_frota_id', ''));
    }

    function isV2VehicleActivity() {
      return (request.resource.data.get('tipo', '') == 'saida'
          || request.resource.data.get('tipo', '') == 'chegada')
        && request.resource.data.get('item_frota_id', null) is string;
    }

    function hasLegacyActivityDriver() {
      return nonEmptyString(request.resource.data.get('motoristaUid', ''))
        || nonEmptyString(request.resource.data.get('motorista', ''))
        || (
          request.resource.data.get('motorista', null) is map
          && nonEmptyString(request.resource.data.get('motorista', {}).get('uid', ''))
        );
    }

    function legacyActivityTargetsCurrentUser() {
      return request.resource.data.get('motoristaUid', '') == request.auth.uid
        || request.resource.data.get('motorista', '') == request.auth.uid
        || (request.resource.data.get('motorista', null) is map
          && request.resource.data.get('motorista', {}).get('uid', '') == request.auth.uid);
    }

    function hasLegacyActivityShape() {
      return request.resource.data.get('motorista', null) is string
        || request.resource.data.keys().hasAny(['motoristaUid'])
        || request.resource.data.get('criadoPor', null) is string
        || request.resource.data.keys().hasAny(['criadoPorUid']);
    }

    // Saída/Chegada: the driver (motorista) registers their own; mecanico and adm2 register for someone who has motorista.
    function activityDriverAllowed() {
      let motoristaUid = request.resource.data.get('motorista', {}).get('uid', '');
      return (hasEitherPerfil('motorista', 'adm2') && motoristaUid == request.auth.uid)
        || (hasEitherPerfil('mecanico', 'adm2') && employeeHasCredential(motoristaUid, 'motorista'));
    }

    // ---------------------------------------------------------------- fuel V2 (contract: Manuscript 02_PROCESSOS)
    // Snapshot { uid, nome } of an active employee (by uid) holding credential a or b. The app picks the frentista
    // from the frentista list and the motorista/operador from the motorista list (a typed name has uid null); the Kiosk
    // uses its own employee as frentista. The name is not compared with the registry (a rename must not break writes).
    function activeEmployeeSnapshot(value, a, b) {
      let uid = value is map ? value.get('uid', '') : '';
      let funcionario = nonEmptyString(uid) && exists(/databases/$(database)/documents/funcionarios/$(uid))
        ? get(/databases/$(database)/documents/funcionarios/$(uid)).data
        : {};
      let perfis = funcionario.get('perfis', {});
      return value is map
        && nonEmptyString(uid)
        && funcionario.get('ativo', false) == true
        && (perfis.get(a, false) == true || perfis.get(b, false) == true);
    }

    function validFuelMotoristaOperador(data) {
      let motorista = data.get('motoristaOperador', {});
      return motorista is map
        && (motorista.get('uid', null) == null || activeEmployeeSnapshot(motorista, 'motorista', 'motorista'));
    }

    // The author is the signed-in person (by uid; the name is not compared).
    function validFuelCriadoPor(data) {
      let criadoPor = data.get('criadoPor', {});
      return criadoPor is map
        && criadoPor.get('uid', '') == request.auth.uid;
    }

    // Optional number: absent, null or an integer.
    function intOrNull(value) {
      return value == null || value is int;
    }

    // Kilometre or hour meter, when given, is an integer.
    function validFuelMedidor(data) {
      return intOrNull(data.get('quilometragem', null))
        && intOrNull(data.get('horimetro', null));
    }

    // An existing obras-v2 work, by ID.
    function validFuelV2Obra(data) {
      let obraId = data.get('id_obra', '');
      return nonEmptyString(obraId)
        && exists(/databases/$(database)/documents/obras-v2/$(obraId));
    }

    // Volumes and amounts of a fuel movement are integers (negative stock is allowed: purchases are not always
    // registered before the outputs).
    function fuelMovementIntegers(data) {
      let preco = data.get('origemPreco', null);
      return data.get('quantidadeAbastecida', null) is int
        && data.get('valorAbastecimento', null) is int
        && data.get('estoqueAntes', null) is int
        && data.get('estoqueAposMovimento', null) is int
        && data.get('montanteAntes', null) is int
        && data.get('montanteAposMovimento', null) is int
        && intOrNull(data.get('arla', null))
        && (!(preco is map) || intOrNull(preco.get('precoLitro', null)));
    }

    // Saída V2 (frentista or adm2, Kiosk included; logistica in the WEB Combustível): item, obra and people by ID; the
    // frentista holds frentista or adm2.
    function validFuelV2Create() {
      let data = request.resource.data;
      return temArea('frentista', 'logistica')
        && data.get('tipo', '') == 'saida'
        && data.get('data', null) is timestamp
        && validFuelCriadoPor(data)
        && fleetItemExists(data.get('item_frota_id', ''))
        && validFuelV2Obra(data)
        && validFuelMotoristaOperador(data)
        && activeEmployeeSnapshot(data.get('frentista', null), 'frentista', 'adm2')
        && fuelMovementIntegers(data)
        && validFuelMedidor(data);
    }

    // Saída V2 of the app's automatic adjustment ("Ajuste de montante", contract: Manuscript
    // 02_PROCESSOS/combustivel-saida-v2.md): covers the totalizer jump, so people, item and obra may be unknown.
    function validFuelAjusteV2Create() {
      let data = request.resource.data;
      return hasEitherPerfil('frentista', 'adm2')
        && data.get('tipo', '') == 'saida'
        && data.get('motivo', '') == 'Ajuste de montante'
        && data.get('data', null) is timestamp
        && validFuelCriadoPor(data)
        && fuelMovementIntegers(data)
        && validFuelMedidor(data);
    }

    // Entrada V2 (WEB Bombas: logistica, mecanico or adm2). montanteSnapshot is an integer or null (the app writes null).
    function validFuelEntradaV2Create() {
      let data = request.resource.data;
      return data.get('tipo', '') == 'entrada'
        && data.get('data', null) is timestamp
        && validFuelCriadoPor(data)
        && data.get('litrosComprados', null) is int
        && data.get('preco', null) is int
        && data.get('precoLitro', null) is int
        && data.get('estoqueAntes', null) is int
        && data.get('estoqueAposMovimento', null) is int
        && (data.get('montanteSnapshot', null) == null || data.get('montanteSnapshot', null) is int);
    }

    // Untyped legacy record (automatic divergence adjustment of the app, external fuelling registered with a
    // maintenance in the WEB). If identity fields are present they cannot be forged.
    function validLegacyFuelCreate() {
      let data = request.resource.data;
      return data.get('tipo', null) == null
        && data.get('schemaVersion', null) != 2
        && (data.get('motivo', '') != 'Abastecimento de Diesel' || isAdm2())
        && data.get('uid', request.auth.uid) == request.auth.uid
        && data.get('criadoPorUid', request.auth.uid) == request.auth.uid
        && (hasEitherPerfil('frentista', 'adm2') || data.get('motoristaUid', request.auth.uid) == request.auth.uid);
    }

    function isV2PumpUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'ultimaEntrada',
        'ultimaMovimentacao',
        'atualizadoEm'
      ]);
    }

    function validV2PumpUpdate() {
      return request.resource.data.get('estoqueAtual', null) is int
        && request.resource.data.get('montanteAtual', null) is int
        && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['ultimaEntrada'])
          || (
            request.resource.data.get('ultimaEntrada', null) is map
            && request.resource.data.get('ultimaEntrada', {}).get('litrosComprados', null) is int
            && request.resource.data.get('ultimaEntrada', {}).get('preco', null) is int
            && request.resource.data.get('ultimaEntrada', {}).get('precoLitro', null) is int
          )
        );
    }


    // ================================================================ identity and app metadata
    // 00-autorizados (legacy profiles) was deleted on 2026-11-11 and falls under the default deny.

    match /Versionamento/app {
      allow read: if signedIn();
      allow write: if false;
    }

    // ================================================================ client portal (Manuscript users.md, portal.md)

    // A portal client is users/{uid}; clients are not employees. The account and the document are created together by a
    // Function (Admin SDK). documentos (CNPJ/CPF, digits only) decides which contracts the client sees; only the team (engenharia, escritorio, adm2) sets it.
    function clientePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isClienteAtivo() {
      return signedIn()
        && exists(clientePath())
        && get(clientePath()).data.get('ativo', false) == true;
    }

    // CNPJ/CPF of the signed-in active client; empty for anyone else.
    function clienteDocumentos() {
      return isClienteAtivo() ? get(clientePath()).data.get('documentos', []) : [];
    }

    // The record belongs to a contract of the client's CNPJ/CPF. Client queries filter clienteDocumento with `in`.
    function isClienteDe(data) {
      return data.get('clienteDocumento', '') in clienteDocumentos();
    }

    function isCnpjCpf(value) {
      return value is string && value.matches('^([0-9]{11}|[0-9]{14})$');
    }

    function autorEhOProprio(pessoa) {
      return pessoa is map && pessoa.get('uid', '') == request.auth.uid;
    }

    function inteiroOuNulo(value) {
      return value == null || value is int;
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isEquipePortal());
      allow list: if isEquipePortal();

      // The client changes only the display name, with the server time; documentos and ativo belong to the team.
      allow update: if signedIn()
        && (
          isEquipePortal()
          || (
            request.auth.uid == uid
            && changedOnly(['nome', 'atualizadoEm'])
            && nonEmptyString(request.resource.data.get('nome', ''))
            && request.resource.data.get('atualizadoEm', null) == request.time
          )
        );

      allow create, delete: if false;

      // Notices to the client, written by Functions; the client only marks them as read.
      match /notificacoes/{notificacaoId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow update: if signedIn()
          && request.auth.uid == uid
          && changedOnly(['lida'])
          && request.resource.data.lida is bool;
        allow create, delete: if false;
      }
    }

    // Contract shown in the portal: same ID as obras-v2. Written only by the team; nobody deletes.
    function validPortalObra(obraId) {
      let data = request.resource.data;
      return exists(/databases/$(database)/documents/obras-v2/$(obraId))
        && isCnpjCpf(data.get('clienteDocumento', null))
        && inteiroOuNulo(data.get('valorContrato', null));
    }

    match /portal-obras/{obraId} {
      allow read: if isEquipePortal() || isClienteDe(resource.data);
      allow create: if isEquipePortal()
        && validPortalObra(obraId)
        && autorEhOProprio(request.resource.data.get('criadoPor', null));
      allow update: if isEquipePortal()
        && validPortalObra(obraId)
        && didNotChange(['criadoEm', 'criadoPor']);
      allow delete: if false;
    }

    // Record of a published contract: obraId of a portal-obras document with the same clienteDocumento.
    function portalFilhoDaObra(data) {
      let obraId = data.get('obraId', '');
      return nonEmptyString(obraId)
        && exists(/databases/$(database)/documents/portal-obras/$(obraId))
        && get(/databases/$(database)/documents/portal-obras/$(obraId)).data.get('clienteDocumento', '')
          == data.get('clienteDocumento', null);
    }

    // The client sees what is not in the trash. excluidoEm is read directly (always present by contract) so that a
    // query must filter excluidoEm == null to be allowed.
    function isClienteDeAtivo(data) {
      return isClienteDe(data) && data.excluidoEm == null;
    }

    // Documents and photos: the team sends and moves to the trash (excluidoEm); the client only reads.
    function validPortalArquivoEquipeCreate() {
      return portalFilhoDaObra(request.resource.data)
        && autorEhOProprio(request.resource.data.get('criadoPor', null));
    }

    function validPortalArquivoEquipeUpdate() {
      return portalFilhoDaObra(request.resource.data)
        && didNotChange(['obraId', 'criadoEm', 'criadoPor']);
    }

    match /portal-documentos/{documentoId} {
      allow read: if isEquipePortal() || isClienteDeAtivo(resource.data);
      allow create: if isEquipePortal() && validPortalArquivoEquipeCreate();
      allow update: if isEquipePortal() && validPortalArquivoEquipeUpdate();
      allow delete: if false;
    }

    match /portal-fotos/{fotoId} {
      allow read: if isEquipePortal() || isClienteDeAtivo(resource.data);
      allow create: if isEquipePortal() && validPortalArquivoEquipeCreate();
      allow update: if isEquipePortal() && validPortalArquivoEquipeUpdate();
      allow delete: if false;
    }

    // Installments typed by the team (money in cents). The client only sends the payment receipt of a pending or rejected
    // installment, stored under the installment's own Storage folder.
    function validPortalParcela() {
      let data = request.resource.data;
      return portalFilhoDaObra(data)
        && data.get('valor', null) is int
        && data.get('numero', null) is int;
    }

    function clienteEnviaComprovante(parcelaId) {
      let data = request.resource.data;
      let comprovante = data.get('comprovante', null);
      return isClienteDeAtivo(resource.data)
        && resource.data.get('status', '') in ['pendente', 'rejeitado']
        && changedOnly(['status', 'comprovante', 'comprovanteEnviadoEm', 'comprovanteEnviadoPor', 'observacaoCliente', 'atualizadoEm'])
        && data.get('status', '') == 'comprovante_enviado'
        && comprovante is map
        && comprovante.get('path', '').matches(
          '^portal/obras/' + resource.data.obraId + '/parcelas/' + parcelaId + '/comprovante/[^/]+$'
        )
        && autorEhOProprio(data.get('comprovanteEnviadoPor', null))
        && data.get('comprovanteEnviadoEm', null) == request.time
        && data.get('atualizadoEm', null) == request.time;
    }

    match /portal-parcelas/{parcelaId} {
      allow read: if isEquipePortal() || isClienteDeAtivo(resource.data);
      allow create: if isEquipePortal() && validPortalParcela();
      allow update: if (isEquipePortal() && validPortalParcela() && didNotChange(['obraId', 'criadoEm']))
        || clienteEnviaComprovante(parcelaId);
      allow delete: if false;
    }

    // Support tickets: shared by every login of the same CNPJ/CPF. The client opens a ticket for one of its contracts
    // and updates only the last-message summary and unread counters; the team answers and changes the status.
    function clienteAbreAtendimento() {
      let data = request.resource.data;
      return isClienteDe(data)
        && portalFilhoDaObra(data)
        && autorEhOProprio(data.get('criadoPor', null))
        && data.get('status', '') == 'aberto'
        && data.get('criadoEm', null) == request.time;
    }

    match /portal-atendimentos/{atendimentoId} {
      allow read: if isEquipePortal() || isClienteDe(resource.data);
      allow create: if clienteAbreAtendimento()
        || (isEquipePortal() && portalFilhoDaObra(request.resource.data));
      allow update: if (
          isEquipePortal()
          && portalFilhoDaObra(request.resource.data)
          && didNotChange(['obraId', 'clienteDocumento', 'criadoPor', 'criadoEm'])
        )
        || (
          isClienteDe(resource.data)
          && changedOnly(['ultimaMensagem', 'naoLidasEquipe', 'naoLidasCliente', 'atualizadoEm'])
          && request.resource.data.get('naoLidasEquipe', 0) is int
          && request.resource.data.get('naoLidasCliente', 0) is int
        );
      allow delete: if false;

      function atendimento() {
        return get(/databases/$(database)/documents/portal-atendimentos/$(atendimentoId)).data;
      }

      // Messages are immutable; the author is the signed-in user, as client or as the team.
      match /mensagens/{mensagemId} {
        allow read: if isEquipePortal() || isClienteDe(atendimento());
        allow create: if autorEhOProprio(request.resource.data.get('autor', null))
          && request.resource.data.get('criadoEm', null) == request.time
          && (
            (isClienteDe(atendimento()) && request.resource.data.get('autorTipo', '') == 'cliente')
            || (isEquipePortal() && request.resource.data.get('autorTipo', '') == 'equipe')
          );
        allow update, delete: if false;
      }
    }

    // News for every active client; the team writes the institutional ones (external news come from Functions).
    match /portal-noticias/{noticiaId} {
      allow read: if isEquipePortal()
        || (
          isClienteAtivo()
          && resource.data.status == 'publicada'
          && resource.data.excluidoEm == null
        );
      allow create, update: if isEquipePortal();
      allow delete: if false;
    }

    // portal-emails (e-mail queue) is Functions-only: the default deny at the end covers it.

    // Canonical employee identity, written only by the Admin SDK (admin API and Kiosk Functions).
    // Listing (and reading another person) is open to who picks people (lePessoas: the app's frentista and motorista
    // pickers, Friday, Combustível, Frota, Bombas, Logística); the whole document is returned (a name-only projection
    // is a pending improvement).
    match /funcionarios/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || lePessoas());
      allow list: if lePessoas();
      // A pessoa ativa só grava o próprio último acesso, com a hora do servidor (a WEB, ao abrir); o resto é das Functions.
      allow update: if isAuthorized()
        && request.auth.uid == uid
        && changedOnly(['ultimoAcesso'])
        && request.resource.data.ultimoAcesso == request.time;
      allow create, delete: if false;

      // Push tokens of the devices where the person is signed in to the app (one document per device, id = token).
      // The app writes its own on login and deletes it on sign-out, also when the person became inactive; only the
      // Functions (Admin SDK) read them.
      match /fcmTokens/{tokenId} {
        allow read: if false;
        allow create, update: if isAuthorized()
          && request.auth.uid == uid
          && request.resource.data.get('token', '') == tokenId;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    // Kiosk credentials, rate limits, admin config and audit: Admin SDK only.
    match /kioskCredentials/{uid} {
      allow read, write: if false;
    }
    match /kioskRateLimits/{key} {
      allow read, write: if false;
    }
    match /kioskAdminConfig/{key} {
      allow read, write: if false;
    }
    match /kioskAudit/{eventId} {
      allow read, write: if false;
    }

    // Schema documentation is administrative metadata, never runtime state.
    match /schema-info/{documentId} {
      allow read, write: if false;
    }


    // ================================================================ engineering (CronoObra, monday, ERP)

    // monday projection (obras and subitems), written only by the monday Functions.
    match /monday-obras/{obraId} {
      allow read: if isEngenharia();
      allow write: if false;
    }

    // Master builders used by the CronoObra planning (document id normalized from the name).
    match /monday-mestres/{mestreId} {
      allow read: if isEngenharia();
      allow create, update: if hasEitherPerfil('engenharia', 'adm2')
        && request.resource.data.keys().hasOnly(['nome', 'cor'])
        && nonEmptyString(request.resource.data.nome)
        && request.resource.data.get('cor', '') is string;
      allow delete: if false;
    }

    // Shared CronoObra allocations. obraId is present only when the allocation targets an obra (contract-level
    // allocations have none). Employee document IDs are Firebase Auth UIDs.
    function validCronogramaAlocacao(data) {
      return data.keys().hasAll([
          'contratoId',
          'mestreId',
          'inicio',
          'tempoPlanejado',
          'criadoPorFuncionarioId',
          'criadoEm',
          'atualizadoEm'
        ])
        && (!data.keys().hasAny(['obraId']) || nonEmptyString(data.obraId))
        && nonEmptyString(data.contratoId)
        && nonEmptyString(data.mestreId)
        && data.inicio is string
        && data.inicio.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && data.tempoPlanejado is int
        && data.tempoPlanejado > 0
        && nonEmptyString(data.criadoPorFuncionarioId)
        && data.criadoEm is timestamp
        && data.atualizadoEm is timestamp;
    }

    match /monday-cronograma/{alocacaoId} {
      allow read: if isEngenharia();
      allow create: if isEngenharia()
        && validCronogramaAlocacao(request.resource.data)
        && request.resource.data.criadoPorFuncionarioId == request.auth.uid;
      allow update: if isEngenharia()
        && validCronogramaAlocacao(request.resource.data)
        && didNotChange(['criadoPorFuncionarioId', 'criadoEm', 'obraId', 'contratoId']);
      allow delete: if isEngenharia();
    }

    // ERP balances are written exclusively by the Admin SDK Function.
    match /monday-serp/{idObra} {
      allow read: if isEngenharia();
      allow write: if false;
    }

    // ERP (Query 47) guardado por veículo: só a Function grava; valores e fornecedores, então só a Frota lê.
    match /erp-veiculos/{veiculoId} {
      allow read: if isFrota();
      allow write: if false;
    }


    // ================================================================ fleet and registrations

    // Legacy (no reader in the current WEB or app): only adm2 reads.
    match /veiculos/{veiculoId} {
      allow read: if isAdm2();
      allow create: if isAdm2();

      // Operational users may only update shared mileage state.
      allow update: if
        isAdm2()
        || (
          isAuthorized()
          && changedOnly([
            'quilometragemUltima',
            'dataUltimaAtualizacao'
          ])
        );

      allow delete: if false;
    }

    // Fleet V2. Operational users (Saída/Chegada, fuel and checklist) update only the last meter reading, never
    // backwards, whether or not the item is active. The mechanic may correct it downwards (checklist "Esse é o KM
    // correto", `medidor.corrigido`).
    match /veiculos-v2/{itemFrotaId} {
      allow read: if isAuthorized();
      allow create: if isAdm2();
      allow update: if
        isAdm2()
        // WEB Frota (vehicle detail): only the name and the initial meter with its date and origin.
        || (
          isFrota()
          && changedOnly(['identificacao'])
          && request.resource.data.identificacao.diff(resource.data.get('identificacao', {})).affectedKeys().hasOnly(['nome'])
          && nonEmptyString(request.resource.data.identificacao.nome)
        )
        || (
          isFrota()
          && changedOnly(['operacional'])
          && request.resource.data.operacional.diff(resource.data.get('operacional', {})).affectedKeys()
            .hasOnly(['quilometragemInicial', 'dataQuilometragemInicial', 'origemQuilometragemInicial'])
        )
        // WEB Frota KM normalization (logistica or adm2): the last meter reading, in either direction.
        || (
          temArea('logistica', 'logistica')
          && changedOnly(['operacional'])
          && request.resource.data.operacional.diff(resource.data.get('operacional', {})).affectedKeys()
            .hasOnly(['quilometragemUltima'])
          && request.resource.data.operacional.quilometragemUltima is int
          && request.resource.data.operacional.quilometragemUltima >= 0
        )
        || (
          isAuthorized()
          && changedOnly(['operacional'])
          && request.resource.data.operacional.diff(resource.data.get('operacional', {}))
            .affectedKeys().hasOnly(['quilometragemUltima', 'dataUltimaAtualizacao'])
          && request.resource.data.operacional.quilometragemUltima is int
          && (
            resource.data.get('operacional', {}).get('quilometragemUltima', null) == null
            || request.resource.data.operacional.quilometragemUltima
              >= resource.data.operacional.quilometragemUltima
            || isMecanico()
          )
        );
      allow delete: if false;
    }

    // Legacy (no reader in the current WEB or app): only adm2 reads.
    match /obras/{obraId} {
      allow read: if isAdm2();
      allow create, update, delete: if isAdm2();
    }

    // CronoObra "Próxima a iniciar": one write changes only `lotes.{id}.prioridade` (number) of one existing LOTE.
    // Rules cannot take the changed key out of a set, so each LOTE is checked by position (up to 40 per contract).
    function loteSoPrioridade(antes, depois, chave) {
      return depois[chave] == antes[chave]
        || (
          depois[chave].diff(antes[chave]).affectedKeys().hasOnly(['prioridade'])
          && depois[chave].prioridade is number
        );
    }

    function loteNaPosicao(antes, depois, chaves, i) {
      return chaves.size() <= i || loteSoPrioridade(antes, depois, chaves[i]);
    }

    function prioridadeDeUmLote() {
      let antes = resource.data.get('lotes', {});
      let depois = request.resource.data.get('lotes', {});
      let mudou = depois.diff(antes);
      let chaves = antes.keys();
      return changedOnly(['lotes'])
        && mudou.addedKeys().size() == 0
        && mudou.removedKeys().size() == 0
        && mudou.changedKeys().size() == 1
        && chaves.size() <= 40
        && loteNaPosicao(antes, depois, chaves, 0) && loteNaPosicao(antes, depois, chaves, 1) && loteNaPosicao(antes, depois, chaves, 2) && loteNaPosicao(antes, depois, chaves, 3)
        && loteNaPosicao(antes, depois, chaves, 4) && loteNaPosicao(antes, depois, chaves, 5) && loteNaPosicao(antes, depois, chaves, 6) && loteNaPosicao(antes, depois, chaves, 7)
        && loteNaPosicao(antes, depois, chaves, 8) && loteNaPosicao(antes, depois, chaves, 9) && loteNaPosicao(antes, depois, chaves, 10) && loteNaPosicao(antes, depois, chaves, 11)
        && loteNaPosicao(antes, depois, chaves, 12) && loteNaPosicao(antes, depois, chaves, 13) && loteNaPosicao(antes, depois, chaves, 14) && loteNaPosicao(antes, depois, chaves, 15)
        && loteNaPosicao(antes, depois, chaves, 16) && loteNaPosicao(antes, depois, chaves, 17) && loteNaPosicao(antes, depois, chaves, 18) && loteNaPosicao(antes, depois, chaves, 19)
        && loteNaPosicao(antes, depois, chaves, 20) && loteNaPosicao(antes, depois, chaves, 21) && loteNaPosicao(antes, depois, chaves, 22) && loteNaPosicao(antes, depois, chaves, 23)
        && loteNaPosicao(antes, depois, chaves, 24) && loteNaPosicao(antes, depois, chaves, 25) && loteNaPosicao(antes, depois, chaves, 26) && loteNaPosicao(antes, depois, chaves, 27)
        && loteNaPosicao(antes, depois, chaves, 28) && loteNaPosicao(antes, depois, chaves, 29) && loteNaPosicao(antes, depois, chaves, 30) && loteNaPosicao(antes, depois, chaves, 31)
        && loteNaPosicao(antes, depois, chaves, 32) && loteNaPosicao(antes, depois, chaves, 33) && loteNaPosicao(antes, depois, chaves, 34) && loteNaPosicao(antes, depois, chaves, 35)
        && loteNaPosicao(antes, depois, chaves, 36) && loteNaPosicao(antes, depois, chaves, 37) && loteNaPosicao(antes, depois, chaves, 38) && loteNaPosicao(antes, depois, chaves, 39);
    }

    // Obras V2 are written by the monday Functions; adm2 kept for administrative maintenance.
    match /obras-v2/{obraId} {
      allow read: if isAuthorized();
      allow create, delete: if isAdm2();
      // The registration belongs to Friday; in /engenharia/obras Engenharia only fills in the work site (`local`,
      // required) and the synonym (`siglaObra`, may be empty); in /engenharia/cronograma, a LOTE's `prioridade`.
      allow update: if isAdm2()
        || (hasPerfil('engenharia') && prioridadeDeUmLote())
        || (
          hasPerfil('engenharia')
          && changedOnly(['local', 'siglaObra'])
          && nonEmptyString(request.resource.data.local)
          && request.resource.data.local.size() <= 200
          && request.resource.data.get('siglaObra', '') is string
          && request.resource.data.get('siglaObra', '').size() <= 100
        );
    }

    match /motivos/{motivoId} {
      allow read: if isAuthorized();
      allow write: if false;
    }

    // Categories and suppliers of the old WEB maintenance records (no cadastro screen since 2026-11-06; new
    // maintenance lives in the ERP). Frota reads them to name old records and in the KPI.
    match /notas-categorias/{documentId} {
      allow read: if isFrota();
      allow create, update, delete: if isFrota();
    }

    match /notas-fornecedores/{documentId} {
      allow read: if isFrota();
      allow create, update, delete: if isFrota();
    }

    match /notas-fornecedores-numeros/{documentId} {
      allow read: if isFrota();
      allow create, update, delete: if isFrota();
    }

    match /app-metadata/notas-fornecedores-numero {
      allow read: if isFrota();
      allow create, update: if isFrota();
      allow delete: if false;
    }


    // ================================================================ activities

    match /atividades/{atividadeId} {
      // Full listings: Frota (WEB) and Engenharia (obra detail, by id_obra). Everyone else reads their own (app
      // Histórico) and, in the app's send transaction, the id about to be created (resource == null).
      allow get: if isFrota() || isEngenharia()
        || (isAuthorized() && (resource == null || atividadeDoProprio(resource.data)));
      allow list: if isFrota() || isEngenharia() || (isAuthorized() && atividadeDoProprio(resource.data));

      // V2 and migrated activities carry driver and author snapshots; mecanico/adm2 register for another driver.
      allow create: if
        isAuthorized()
        && request.resource.data.get('criadoPorUid', request.auth.uid) == request.auth.uid
        && (
          (
            isV2VehicleActivity()
            && validItemFrotaSnapshot()
            && hasMigratedDriverSnapshot()
            && hasMigratedAuthorSnapshot()
            && activityDriverAllowed()
          )
          || (
            !isV2VehicleActivity()
            && isMigratedVehicleActivity()
            && hasMigratedDriverSnapshot()
            && hasMigratedAuthorSnapshot()
            && activityDriverAllowed()
          )
          || (
            !isMigratedVehicleActivity()
            && hasLegacyActivityDriver()
            && hasLegacyActivityShape()
            && (hasEitherPerfil('mecanico', 'adm2') || legacyActivityTargetsCurrentUser())
          )
        );

      // Activity history is immutable, except the odometer reading corrected by the WEB Frota KM normalization
      // (logistica or adm2), as a non-negative integer.
      allow update: if
        temArea('logistica', 'logistica')
        && changedOnly(['km'])
        && request.resource.data.km is int
        && request.resource.data.km >= 0;
      allow delete: if false;

      match /checklist_saida/{itemId} {
        allow read: if isFrota() || isEngenharia()
          || (isAuthorized() && atividadeDoProprio(get(/databases/$(database)/documents/atividades/$(atividadeId)).data));

        allow create: if
          isAuthorized()
          && request.resource.data.get('criadoPorUid', request.auth.uid) == request.auth.uid;

        allow update, delete: if false;
      }

      match /checklist_chegada/{itemId} {
        allow read: if isFrota() || isEngenharia()
          || (isAuthorized() && atividadeDoProprio(get(/databases/$(database)/documents/atividades/$(atividadeId)).data));

        // Catalog version and payload shape are application concerns.
        allow create: if
          isAuthorized()
          && request.resource.data.get('criadoPorUid', request.auth.uid) == request.auth.uid;

        allow update, delete: if false;
      }
    }

    // Mechanic checklist (app), written once after its photos are uploaded; immutable. Mechanics read every checklist
    // (the app remembers "Não se aplica" per vehicle), and the saving transaction reads the document before it exists.
    function validChecklistV2Create() {
      let data = request.resource.data;
      let itemId = data.get('item_frota_id', '');
      let medidor = data.get('medidor', {});
      return data.get('criadoPorUid', '') == request.auth.uid
        && data.get('criadoPor', null) is map
        && data.get('criadoPor', {}).get('uid', '') == request.auth.uid
        && fleetItemExists(itemId)
        && medidor is map
        && medidor.get('valor', null) is int
        && data.get('itens', null) is list;
    }

    // Driver/operator: a name, and a uid that is null (typed name) or an active employee. Signature: the file of this
    // checklist, or "motorista ausente" with a reason.
    function validChecklistV2Pessoas(checklistId) {
      let data = request.resource.data;
      let motorista = data.get('motoristaOperador', null);
      let uid = motorista is map ? motorista.get('uid', null) : null;
      let funcionario = nonEmptyString(uid) && exists(/databases/$(database)/documents/funcionarios/$(uid))
        ? get(/databases/$(database)/documents/funcionarios/$(uid)).data
        : {};
      let assinatura = data.get('assinatura', null);
      let status = assinatura is map ? assinatura.get('status', '') : '';
      return motorista is map
        && nonEmptyString(motorista.get('nome', ''))
        && motorista.get('nome', '').trim() != ''
        && (uid == null || funcionario.get('ativo', false) == true)
        && assinatura is map
        && (
          (status == 'assinada' && assinatura.get('path', '') == 'checklists-v2/' + checklistId + '/assinatura_1.jpg')
          || (
            status == 'ausente'
            && nonEmptyString(assinatura.get('motivo', ''))
            && assinatura.get('motivo', '').trim() != ''
          )
        );
    }

    match /checklists-v2/{checklistId} {
      allow read: if isFrota();
      allow create: if (isMecanico() || isAdm2()) && validChecklistV2Create() && validChecklistV2Pessoas(checklistId);
      allow update, delete: if false;
    }


    // ================================================================ fuel

    match /03-combustivel/{registroId} {
      // Full reads: Combustível, Bombas and Frota (WEB: logistica, mecanico), Engenharia (obra detail), frentista and
      // the Kiosk (app: last record and entries, unfiltered). Everyone else reads their own (app Histórico).
      allow read: if isLogistica() || isEngenharia() || isFrentista()
        || (isAuthorized() && combustivelDoProprio(resource.data));

      allow create: if
        isAuthorized()
        && (
          validFuelV2Create()
          || validFuelAjusteV2Create()
          || (isLogistica() && validFuelEntradaV2Create())
          || validLegacyFuelCreate()
        );

      // Corrections: Combustível (logistica or adm2: adjustments replaced by lançamentos, document inspector), the Admin
      // SDK (WEB /combustivel API) or the administrative claim.
      allow update, delete: if temArea('logistica', 'logistica') || hasAdminClaim();
    }

    match /bombas/{bombaId} {
      // WEB Bombas/Combustível (logistica, mecanico, adm2), the app's frentista and the Kiosk.
      allow read: if isLogistica() || isFrentista();

      // The frentista (app, Kiosk) and the WEB Bombas/Combustível (logistica, mecanico) modify only the shared fuel
      // state; adm2 anything.
      allow update: if
        isAdm2()
        || (
          (isFrentista() || isLogistica())
          && changedOnly([
            'montanteAtual',
            'estoqueAtual',
            'ultimoAbastecimento',
            'ultimoFrentista',
            'ultimaEntrada',
            'ultimaMovimentacao',
            'atualizadoEm'
          ])
          && (!isV2PumpUpdate() || validV2PumpUpdate())
        );

      allow create, delete: if false;
    }

    match /00-chamados/{chamadoId} {
      // The app intentionally queries conflicts across drivers.
      allow read: if isAuthorized();

      allow create: if
        isAuthorized()
        && request.resource.data.get('criadoPorUid', request.auth.uid) == request.auth.uid
        && (
          hasEitherPerfil('frentista', 'adm2')
          || request.resource.data.get('motoristaUid', request.auth.uid) == request.auth.uid
        );

      // New operational fields are allowed; identity/origin is immutable.
      allow update: if
        isAuthorized()
        && didNotChange([
          'motorista',
          'motoristaUid',
          'criadoPorUid',
          'tipo',
          'data'
        ]);

      allow delete: if false;
    }

    match /configuracoes/{configId} {
      allow read: if isAuthorized();
      allow create, update: if isAdm2();
      allow delete: if false;
    }

    match /notificacoes/{notificationId} {
      allow get: if
        isAdm2()
        || (
          isAuthorized()
          && resource.data.get('motoristaUid', '') == request.auth.uid
        );

      allow list: if isAdm2();

      allow create: if
        isAuthorized()
        && request.resource.data.get('motoristaUid', '') == request.auth.uid;

      allow update: if
        (
          isAdm2()
          || (
            isAuthorized()
            && resource.data.get('motoristaUid', '') == request.auth.uid
          )
        )
        && didNotChange([
          'motoristaUid',
          'chamadoId',
          'tipo',
          'destinatarioPerfil'
        ]);

      allow delete: if false;

      match /leituras/{uid} {
        allow get: if isAdm2() && request.auth.uid == uid;
        allow list: if false;
        allow create, update: if isAdm2() && request.auth.uid == uid;
        allow delete: if false;
      }
    }


    // ================================================================ maintenance

    // Frota (mecanico, logistica, adm2) edits and deletes maintenance records (WEB document inspector); the claim keeps working.
    match /manutencoes/{manutencaoId} {
      allow read: if isFrota() || hasAdminClaim();
      allow create: if isFrota();
      allow update, delete: if isFrota() || hasAdminClaim();
    }


    // ================================================================ DEV (/dev): salas online do Xadrez e do NEO
    // Só a credencial retr0 (exclusiva: nem o adm2 entra sem ela). Partida "de confiança" (decisão do responsável em
    // 2026-11-10): o estado inteiro do jogo fica na sala, em JSON (no NEO, as mãos também); as Rules garantem quem entra,
    // quem começa e de quem é a vez, não as regras do jogo. Toda gravação sobe "versao" em 1 (a tela grava em transação).
    function isRetr0() {
      return hasPerfil('retr0');
    }

    function devSalaCampos() {
      return ['jogo', 'criadaPor', 'jogadores', 'nomes', 'max', 'estado', 'partida', 'vez', 'versao', 'criadaEm', 'atualizadaEm'];
    }

    // Entrar numa sala aberta com vaga: acrescenta o próprio uid (e o nome) no fim.
    function devSalaEntrar() {
      return resource.data.estado == 'aberta'
        && !(request.auth.uid in resource.data.jogadores)
        && request.resource.data.jogadores == resource.data.jogadores.concat([request.auth.uid])
        && request.resource.data.jogadores.size() <= resource.data.max
        && changedOnly(['jogadores', 'nomes', 'versao', 'atualizadaEm']);
    }

    // Sair de uma sala aberta (quem criou fecha a sala, apagando).
    function devSalaSair() {
      return resource.data.estado == 'aberta'
        && request.auth.uid in resource.data.jogadores
        && request.auth.uid != resource.data.criadaPor
        && request.resource.data.jogadores == resource.data.jogadores.removeAll([request.auth.uid])
        && changedOnly(['jogadores', 'nomes', 'versao', 'atualizadaEm']);
    }

    // Começar: só quem criou, com 2 ou mais na sala; a vez fica com um dos jogadores.
    function devSalaComecar() {
      return resource.data.estado == 'aberta'
        && resource.data.criadaPor == request.auth.uid
        && resource.data.jogadores.size() >= 2
        && request.resource.data.estado == 'jogando'
        && request.resource.data.partida is string
        && request.resource.data.vez in resource.data.jogadores
        && changedOnly(['estado', 'partida', 'vez', 'versao', 'atualizadaEm']);
    }

    // Jogar: só quem está na vez, passando a vez a um jogador ou encerrando (vez nula). Desistir: qualquer jogador,
    // a qualquer momento, encerrando.
    function devSalaJogar() {
      return resource.data.estado == 'jogando'
        && request.auth.uid in resource.data.jogadores
        && request.resource.data.partida is string
        && (
          (request.resource.data.estado == 'fim' && request.resource.data.vez == null)
          || (resource.data.vez == request.auth.uid
            && request.resource.data.estado == 'jogando'
            && request.resource.data.vez in resource.data.jogadores)
        )
        && changedOnly(['estado', 'partida', 'vez', 'versao', 'atualizadaEm']);
    }

    match /dev-salas/{salaId} {
      allow read: if isRetr0();
      // nasce aberta, só com quem criou, sem partida; Xadrez para 2, NEO para até 4
      allow create: if isRetr0()
        && request.resource.data.keys().hasOnly(devSalaCampos())
        && request.resource.data.jogo in ['xadrez', 'neo']
        && request.resource.data.max == (request.resource.data.jogo == 'xadrez' ? 2 : 4)
        && request.resource.data.criadaPor == request.auth.uid
        && request.resource.data.jogadores == [request.auth.uid]
        && request.resource.data.nomes is list
        && request.resource.data.nomes.size() == 1
        && request.resource.data.estado == 'aberta'
        && request.resource.data.partida == null
        && request.resource.data.vez == null
        && request.resource.data.versao == 0
        && request.resource.data.criadaEm == request.time
        && request.resource.data.atualizadaEm == request.time;
      allow update: if isRetr0()
        && request.resource.data.keys().hasOnly(devSalaCampos())
        && request.resource.data.versao == resource.data.versao + 1
        && request.resource.data.atualizadaEm == request.time
        && request.resource.data.nomes is list
        && request.resource.data.nomes.size() == request.resource.data.jogadores.size()
        && (devSalaEntrar() || devSalaSair() || devSalaComecar() || devSalaJogar());
      // quem criou apaga quando quiser; terminada, qualquer jogador apaga
      allow delete: if isRetr0()
        && (resource.data.criadaPor == request.auth.uid
          || (resource.data.estado == 'fim' && request.auth.uid in resource.data.jogadores));
    }


    // ================================================================ Friday (/friday)
    // Gestão interna em quadros: credencial escritorio (ou adm2), com permissão por quadro (Manuscript friday.md).
    function fridayAccess() {
      return hasEitherPerfil('escritorio', 'adm2');
    }

    // Quadro liberado: aberto (restrito != 1) ou restrito com a pessoa em "acesso". adm2 vê todos (conferido à parte).
    // Campos lidos direto, sem .get com padrão: numa lista sem filtro em "restrito", o padrão liberaria todos os quadros.
    function fridayLiberado(q) {
      return q.restrito != 1 || request.auth.uid in q.acesso;
    }

    // Registros de um quadro (quadro_id) seguem o quadro. Toda consulta diz o quadro (== ou "in" de até 10).
    function fridayPodeQuadro(quadroId) {
      return fridayAccess()
        && (isAdm2() || fridayLiberado(get(/databases/$(database)/documents/friday-quadros/$(string(quadroId))).data));
    }

    // Pessoas do Friday: são os funcionários do sistema (funcionarios/{uid}); não há coleção própria.

    // Avisos (sino): qualquer um avisa; só o destinatário lê, marca como lido ou apaga.
    match /friday-notificacoes/{notificacaoId} {
      allow create: if fridayAccess()
        && request.resource.data.usuario_uid is string;
      allow read, delete: if fridayAccess()
        && resource.data.usuario_uid == request.auth.uid;
      allow update: if fridayAccess()
        && resource.data.usuario_uid == request.auth.uid
        && changedOnly(['lida']);
    }

    // Chaves da API do Friday (Function fridayApi): id = SHA-256 da chave, que só aparece na criação. "escrita" (POST) é
    // definida na criação e não muda (para trocar, revoga e cria outra): fica registrado quem criou cada chave com escrita.
    // Só adm2 lista, cria (ativa, em nome dele) e revoga; ninguém apaga. "ultimo_uso" é gravado pela Function.
    match /friday-chaves-api/{hash} {
      allow read: if isAdm2();
      allow create: if isAdm2()
        && hash.matches('^[0-9a-f]{64}$')
        && request.resource.data.keys().hasOnly(['uid', 'nome', 'sufixo', 'escrita', 'criado_por', 'criado_em', 'revogada_em'])
        && request.resource.data.get('escrita', false) is bool
        && request.resource.data.uid is string && request.resource.data.uid.size() > 0
        && request.resource.data.criado_por == request.auth.uid
        && request.resource.data.revogada_em == null;
      allow update: if isAdm2()
        && resource.data.revogada_em == null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['revogada_em', 'revogada_por'])
        && request.resource.data.revogada_em is string
        && request.resource.data.revogada_por == request.auth.uid;
      allow delete: if false;
    }

    // Registro de atividade: só acrescenta (apagado junto com o quadro ou item). Quem grava assina com o próprio uid
    // (usuario_id); o Histórico lista as atividades de uma pessoa em todos os quadros: as próprias, ou qualquer uma
    // para adm2 (que vê todos os quadros).
    match /friday-atividades/{atividadeId} {
      allow read: if fridayPodeQuadro(resource.data.quadro_id)
        || (fridayAccess() && resource.data.usuario_id == request.auth.uid);
      allow delete: if fridayPodeQuadro(resource.data.quadro_id);
      allow create: if fridayPodeQuadro(request.resource.data.quadro_id)
        && request.resource.data.usuario_id == request.auth.uid;
      allow update: if false;
    }

    // Quadros: "cadastro" (cadastro oficial) é gravado só pelas Functions. "restrito", "acesso" e a área de trabalho
    // (area_id) mudam só por adm2; um quadro novo pode nascer restrito (cópia ou subitens de um restrito) se quem cria está na lista.
    match /friday-quadros/{quadroId} {
      allow read, delete: if fridayAccess() && (isAdm2() || fridayLiberado(resource.data));
      allow create: if fridayAccess()
        && request.resource.data.get('cadastro', null) == null
        && (isAdm2() || fridayLiberado(request.resource.data));
      allow update: if fridayAccess()
        && (isAdm2() || fridayLiberado(resource.data))
        && didNotChange(['cadastro'])
        && (isAdm2() || didNotChange(['restrito', 'acesso', 'area_id']));
    }

    // Itens: "vinculo" (cadastro oficial) e o controle da importação do monday são gravados só pelas Functions.
    function fridayItemCamposDeFunction() {
      return ['vinculo', 'importado_em', 'monday_atualizado_em', 'ligacoes_pendentes'];
    }
    match /friday-itens/{itemId} {
      allow read, delete: if fridayPodeQuadro(resource.data.quadro_id);
      allow create: if fridayPodeQuadro(request.resource.data.quadro_id)
        && request.resource.data.get('vinculo', null) == null
        && request.resource.data.get('importado_em', null) == null
        && request.resource.data.get('monday_atualizado_em', null) == null
        && request.resource.data.get('ligacoes_pendentes', null) == null;
      allow update: if fridayPodeQuadro(resource.data.quadro_id)
        && fridayPodeQuadro(request.resource.data.quadro_id)
        && didNotChange(fridayItemCamposDeFunction());
    }

    // Áreas e pastas: abertas para quem entra no Friday (não há permissão por área ou pasta). Mover pasta para outra
    // área (area_id) é só de adm2.
    match /{colecao}/{registroId} {
      allow read, create, delete: if fridayAccess()
        && colecao.matches('^friday-(areas|pastas)$');
      allow update: if fridayAccess()
        && colecao.matches('^friday-(areas|pastas)$')
        && (isAdm2() || didNotChange(['area_id']));
    }

    // Grupos, colunas, visões, atualizações e automações: seguem o quadro (mudar de quadro exige os dois).
    match /{colecao}/{registroId} {
      allow read, delete: if colecao.matches('^friday-(grupos|colunas|visoes|atualizacoes|automacoes)$')
        && fridayPodeQuadro(resource.data.quadro_id);
      allow create: if colecao.matches('^friday-(grupos|colunas|visoes|atualizacoes|automacoes)$')
        && fridayPodeQuadro(request.resource.data.quadro_id);
      allow update: if colecao.matches('^friday-(grupos|colunas|visoes|atualizacoes|automacoes)$')
        && fridayPodeQuadro(resource.data.quadro_id)
        && fridayPodeQuadro(request.resource.data.quadro_id);
    }

    // Anexos: registro de um arquivo enviado ao Storage (friday/<quadro>/<item>/...). Quem anexa grava o próprio uid; não há
    // edição. As cópias do monday (origem_id) são gravadas só pela Function fridayAnexosMonday (Admin SDK).
    match /friday-anexos/{anexoId} {
      allow read, delete: if fridayPodeQuadro(resource.data.quadro_id);
      allow create: if fridayPodeQuadro(request.resource.data.quadro_id)
        && request.resource.data.get('usuario_id', null) == request.auth.uid
        && request.resource.data.get('arquivo', null) is string
        && request.resource.data.arquivo.matches('^friday/[0-9]+/[0-9]+/.+$')
        && request.resource.data.get('origem_id', null) == null;
      allow update: if false;
    }
    // Execuções de automação: gravadas pelo executor (Admin SDK); a tela só lê e exclui em cascata.
    match /friday-execucoes/{execucaoId} {
      allow read, delete: if fridayPodeQuadro(resource.data.quadro_id);
      allow create, update: if false;
    }

    // Marcador dos índices de itens (busca e Meu trabalho).
    match /friday-meta/indices {
      allow get, create, update: if fridayAccess();
      allow list, delete: if false;
    }

    // Situação da importação do monday: gravada e lida só pelas Functions.
    match /friday-importacoes/{boardId} {
      allow read, write: if false;
    }

    // Cadastros oficiais do Friday: leitura por funcionário ativo; gravação só pelas Functions (Admin SDK).
    match /friday-cadastros/{chave} {
      allow get: if fridayAccess();
      allow list, write: if false;
    }
    match /{cadastroColecao}/{cadastroId} {
      allow read: if fridayAccess() && cadastroColecao.matches('^cadastro-[a-z][a-z0-9_]*$');
    }


    // ================================================================ Kiosk tablet battery
    // Bateria do tablet Kiosk (MotoristaV2, docs/KIOSK_BATERIA.md). O Kiosk fica deslogado entre um abastecimento e outro,
    // então grava sem login; sem identidade, o formato é a única proteção: fechado, com valores e horário limitados, e só
    // o adm2 lê. Risco aceito: quem tiver a configuração do projeto pode gravar medições falsas, que só alimentam a tela
    // Dev → Bateria do Kiosk.
    function kioskBateriaCampos() {
      return ['medidoEm', 'motivo', 'nivel', 'carregando', 'fonte', 'temperaturaC', 'tensaoMv', 'saude'];
    }
    function validKioskBateria(data) {
      return data.keys().hasAll(kioskBateriaCampos())
        && data.medidoEm is timestamp
        && data.medidoEm < request.time + duration.value(10, 'm')
        && data.medidoEm > request.time - duration.value(7, 'd')
        && data.motivo in ['inicio', 'hora', 'tomada_ligada', 'tomada_desligada']
        && data.nivel is int && data.nivel >= 0 && data.nivel <= 100
        && data.carregando is bool
        && data.fonte in ['tomada', 'usb', 'sem_fio', 'nenhuma']
        && data.temperaturaC is number && data.temperaturaC > -40 && data.temperaturaC < 120
        && data.tensaoMv is int && data.tensaoMv >= 0 && data.tensaoMv < 10000
        && data.saude in ['boa', 'superaquecida', 'morta', 'sobretensao', 'falha', 'fria', 'desconhecida'];
    }
    match /kioskBateria/{terminalId} {
      allow read: if isAdm2();
      allow create, update: if terminalId.matches('^[A-Z0-9-]{1,40}$')
        && request.resource.data.keys().hasOnly(kioskBateriaCampos().concat(
          ['recebidoEm', 'semEconomiaBateria', 'modelo', 'android', 'versaoApp', 'pendentes']))
        && validKioskBateria(request.resource.data)
        && request.resource.data.recebidoEm == request.time
        && request.resource.data.semEconomiaBateria is bool
        && request.resource.data.modelo is string && request.resource.data.modelo.size() <= 80
        && request.resource.data.android is string && request.resource.data.android.size() <= 20
        && request.resource.data.versaoApp is string && request.resource.data.versaoApp.size() <= 40
        && request.resource.data.pendentes is int
        && request.resource.data.pendentes >= 0 && request.resource.data.pendentes <= 96;
      allow delete: if false;

      match /leituras/{leituraId} {
        allow read: if isAdm2();
        allow create, update: if leituraId.matches('^[0-9]{13}$')
          && request.resource.data.keys().hasOnly(kioskBateriaCampos())
          && validKioskBateria(request.resource.data)
          && leituraId == string(request.resource.data.medidoEm.toMillis());
        allow delete: if false;
      }
    }


    // ================================================================ Logística (/logistica/cronograma)
    // Cronograma Logístico (The Manuscript, 01_FIRESTORE/COLECOES/logistica.md): logistica, mecanico ou adm2 lê e grava.
    function logisticaDataOuNula(value) {
      return value == null || (value is string && value.matches('^\\d{4}-\\d{2}-\\d{2}$'));
    }

    function logisticaRef(value, idField) {
      return value == null
        || (value is map
          && value.keys().hasOnly([idField, 'nome'])
          && nonEmptyString(value[idField])
          && value.nome is string
          && value.nome.size() <= 200);
    }

    // Um a quatro veículos {id, nome}, ou nenhum.
    function logisticaVeiculos(value) {
      return value is list
        && value.size() <= 4
        && (value.size() < 1 || (value[0] != null && logisticaRef(value[0], 'id')))
        && (value.size() < 2 || (value[1] != null && logisticaRef(value[1], 'id')))
        && (value.size() < 3 || (value[2] != null && logisticaRef(value[2], 'id')))
        && (value.size() < 4 || (value[3] != null && logisticaRef(value[3], 'id')));
    }

    // `veiculos` (lista) substitui `veiculo` (um só); os documentos de antes continuam válidos até a WEB gravar a lista.
    function validLogisticaProgramacao(data) {
      return data.keys().hasOnly([
          'schemaVersion', 'cod', 'semanaId', 'item', 'status', 'inicio', 'fim', 'motorista', 'auxiliar', 'veiculo', 'veiculos',
          'obra', 'posicao', 'criadoPorUid', 'criadoEm', 'atualizadoPorUid', 'atualizadoEm'
        ])
        && data.schemaVersion == 1
        && (!('cod' in data) || (data.cod is string && data.cod.matches('^[0-9]{8,9}$')))
        && data.semanaId is string
        && exists(/databases/$(database)/documents/logistica-semanas/$(data.semanaId))
        && data.item is string && data.item.size() >= 1 && data.item.size() <= 200
        && data.status is string && data.status.size() <= 60
        && logisticaDataOuNula(data.inicio)
        && logisticaDataOuNula(data.fim)
        && (data.inicio == null || data.fim == null || data.fim >= data.inicio)
        && logisticaRef(data.motorista, 'uid')
        && logisticaRef(data.auxiliar, 'uid')
        && (!('veiculo' in data) || logisticaRef(data.veiculo, 'id'))
        && (!('veiculos' in data) || logisticaVeiculos(data.veiculos))
        && logisticaRef(data.obra, 'id')
        && data.posicao is number
        && data.atualizadoPorUid == request.auth.uid
        && data.atualizadoEm == request.time;
    }

    match /logistica-semanas/{semanaId} {
      allow read: if isLogistica();
      allow create: if isLogistica()
        && semanaId.matches('^\\d{4}-W\\d{2}$')
        && request.resource.data.keys().hasOnly(['schemaVersion', 'inicio', 'fim', 'abertura', 'criadoPorUid', 'criadoEm'])
        && request.resource.data.schemaVersion == 1
        && logisticaDataOuNula(request.resource.data.inicio) && request.resource.data.inicio != null
        && logisticaDataOuNula(request.resource.data.fim) && request.resource.data.fim != null
        && request.resource.data.fim > request.resource.data.inicio
        && request.resource.data.abertura in ['automatica', 'manual']
        && request.resource.data.criadoPorUid == request.auth.uid
        && request.resource.data.criadoEm == request.time;
      // Só o contador do código das linhas muda (a WEB sobe um na transação que cria a linha). Não se exige "+1" aqui:
      // duas transações que leram o mesmo valor seriam recusadas pela regra em vez de repetidas pela transação.
      allow update: if isLogistica()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['contador'])
        && request.resource.data.contador is int
        && request.resource.data.contador >= 1;
      allow delete: if false;
    }

    match /logistica-programacoes/{programacaoId} {
      allow read: if isLogistica();
      allow create: if isLogistica()
        && validLogisticaProgramacao(request.resource.data)
        && request.resource.data.criadoPorUid == request.auth.uid
        && request.resource.data.criadoEm == request.time;
      allow update: if isLogistica()
        && validLogisticaProgramacao(request.resource.data)
        && didNotChange(['semanaId', 'criadoPorUid', 'criadoEm'])
        && (!('cod' in resource.data) || request.resource.data.get('cod', null) == resource.data.cod);
      allow delete: if isLogistica();
    }

    // Etiquetas de status do quadro (só o documento "status"): lista de {id, nome, cor}, até 40; quem grava assina.
    match /logistica-config/{configId} {
      allow read: if isLogistica();
      allow create, update: if isLogistica()
        && configId == 'status'
        && request.resource.data.keys().hasOnly(['schemaVersion', 'etiquetas', 'atualizadoPorUid', 'atualizadoEm'])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.etiquetas is list
        && request.resource.data.etiquetas.size() <= 40
        && request.resource.data.atualizadoPorUid == request.auth.uid
        && request.resource.data.atualizadoEm == request.time;
      allow delete: if false;
    }

    // Observação de uma programação: texto e/ou até 10 arquivos (Storage logistica/observacoes/), autor = quem grava.
    // Não se edita; qualquer um da área exclui (a WEB mostra a lixeira só ao autor e apaga as da programação excluída).
    match /logistica-observacoes/{observacaoId} {
      allow read: if isLogistica();
      allow create: if isLogistica()
        && request.resource.data.keys().hasOnly(['schemaVersion', 'programacaoId', 'texto', 'anexos', 'autor', 'criadoEm'])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.programacaoId is string
        && exists(/databases/$(database)/documents/logistica-programacoes/$(request.resource.data.programacaoId))
        && request.resource.data.texto is string && request.resource.data.texto.size() <= 2000
        && request.resource.data.anexos is list && request.resource.data.anexos.size() <= 10
        && (request.resource.data.texto.size() > 0 || request.resource.data.anexos.size() > 0)
        && request.resource.data.autor is map
        && request.resource.data.autor.keys().hasOnly(['uid', 'nome'])
        && request.resource.data.autor.uid == request.auth.uid
        && request.resource.data.autor.nome is string && request.resource.data.autor.nome.size() <= 200
        && request.resource.data.criadoEm == request.time;
      allow update: if false;
      allow delete: if isLogistica();
    }


    // Default deny for every undeclared collection and subcollection.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================
    // AUTENTICAÇÃO / PERFIS
    // =========================================================

    function signedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return request.auth.token.get('email', '').lower();
    }

    function profile() {
      return get(
        /databases/$(database)/documents/00-autorizados/$(authEmail())
      ).data;
    }

    function isAuthorized() {
      return signedIn()
        && authEmail() != ''
        && profile().get(
          'ativo',
          profile().get('active', true)
        ) == true;
    }

    function isAdm1() {
      return isAuthorized()
        && (
          profile().get('adm1', false) == true
          || profile().get('role', '') == 'adm1'
          || profile().get('perfil', '') == 'adm1'
        );
    }

    function isAdm2() {
      return isAuthorized()
        && (
          profile().get('adm2', false) == true
          || profile().get('role', '') == 'adm2'
          || profile().get('perfil', '') == 'adm2'
        );
    }

    function hasAdminClaim() {
      return isAuthorized()
        && request.auth.token.get('admin', false) == true;
    }

    function isSelfEmail(email) {
      return signedIn()
        && authEmail() == email;
    }

    function changedOnly(fields) {
      return request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly(fields);
    }


    // =========================================================
    // 00-AUTORIZADOS
    // =========================================================

    match /00-autorizados/{email} {

      // Usuário precisa conseguir carregar o próprio perfil.
      // Adm2 pode consultar documento específico.
      allow get: if isSelfEmail(email) || isAdm2();

      // Nenhum cliente precisa listar todos os autorizados.
      // Functions/Admin SDK continuam funcionando.
      allow list: if false;

      // Perfis são alterados somente pelo backend/Admin SDK.
      allow create, update, delete: if false;


      // -------------------------------------------------------
      // FCM TOKENS
      // -------------------------------------------------------

      match /fcmTokens/{tokenId} {

        allow get, list: if false;

        allow create, update: if
          isSelfEmail(email)
          && isAuthorized()
          && request.resource.data.get('token', '') == tokenId
          && request.resource.data.keys().hasOnly([
            'token',
            'plataforma',
            'atualizadoEm'
          ]);

        // Function com Admin SDK remove tokens inválidos.
        allow delete: if false;
      }
    }


    // =========================================================
    // VERSIONAMENTO
    // =========================================================

    match /Versionamento/app {
      allow read: if signedIn();
      allow write: if false;
    }


    // =========================================================
    // PERFIL LEGADO/REACT
    // users/{auth.uid}
    // =========================================================

    match /users/{uid} {

      allow get: if signedIn()
        && request.auth.uid == uid;

      allow list: if false;

      allow update: if signedIn()
        && request.auth.uid == uid
        && changedOnly([
          'displayName'
        ]);

      allow create, delete: if false;
    }


    // =========================================================
    // VEÍCULOS
    // =========================================================

    match /veiculos/{veiculoId} {

      allow read: if isAuthorized();

      // Cadastro administrativo pelo React.
      allow create: if isAdm2();

      // Adm2 pode editar o cadastro.
      // Usuário normal pode apenas atualizar quilometragem.
      allow update: if
        isAdm2()
        ||
        (
          isAuthorized()
          && changedOnly([
            'quilometragemUltima',
            'dataUltimaAtualizacao'
          ])
        );

      allow delete: if false;
    }


    // =========================================================
    // 01-PLACAS - FLUXO APARENTEMENTE LEGADO
    // =========================================================

    match /01-placas/{placaId} {
      allow get, list: if isAdm2();
      allow create: if isAdm2();
      allow update, delete: if false;
    }


    // =========================================================
    // OBRAS
    // =========================================================

    match /obras/{obraId} {

      allow read: if isAuthorized();

      allow create, update, delete: if isAdm2();
    }


    // =========================================================
    // MOTORISTAS / MOTIVOS
    // =========================================================

    match /motoristas/{motoristaId} {
      allow read: if isAuthorized();
      allow write: if false;
    }

    match /motivos/{motivoId} {
      allow read: if isAuthorized();
      allow write: if false;
    }


    // =========================================================
    // CATEGORIAS
    // =========================================================

    match /notas-categorias/{categoriaId} {

      allow read: if isAdm2();

      allow create, update, delete: if isAdm2();
    }


    // =========================================================
    // FORNECEDORES
    // =========================================================

    match /notas-fornecedores/{fornecedorId} {

      allow read: if isAdm2();

      allow create, update, delete: if isAdm2();
    }


    // =========================================================
    // ÍNDICE DE NÚMEROS DE FORNECEDORES
    // =========================================================

    match /notas-fornecedores-numeros/{numero} {

      allow read: if isAdm2();

      allow create, update, delete: if isAdm2();
    }


    // =========================================================
    // APP METADATA
    // =========================================================

    match /app-metadata/notas-fornecedores-numero {

      allow read: if isAdm2();

      allow create, update: if isAdm2();

      allow delete: if false;
    }


    // =========================================================
    // ATIVIDADES
    // =========================================================

    match /atividades/{atividadeId} {

      // Atualmente React e Flutter fazem listagens amplas.
      allow read: if isAuthorized();

      allow create: if
        isAuthorized()
        && request.resource.data.get(
          'motoristaUid',
          request.auth.uid
        ) == request.auth.uid;

      // Histórico não deve ser alterado depois de criado.
      allow update, delete: if false;


      // -------------------------------------------------------
      // CHECKLIST DE SAÍDA
      // -------------------------------------------------------

      match /checklist_saida/{itemId} {

        allow read: if isAuthorized();

        allow create: if
          isAuthorized()
          && request.resource.data.get(
            'criadoPorUid',
            request.auth.uid
          ) == request.auth.uid;

        allow update, delete: if false;
      }
    }


    // =========================================================
    // COMBUSTÍVEL
    // =========================================================

    match /03-combustivel/{registroId} {

      // Necessário atualmente para queries/listagens dos apps.
      allow read: if isAuthorized();

      allow create: if
        isAuthorized()

        // React possui registros sem uid.
        // Se uid for enviado, precisa ser o usuário autenticado.
        && request.resource.data.get(
          'uid',
          request.auth.uid
        ) == request.auth.uid

        && request.resource.data.get(
          'motoristaUid',
          request.auth.uid
        ) == request.auth.uid;

      // Edição genérica direta somente com claim admin.
      // A API HTTP com Admin SDK não depende destas Rules.
      allow update, delete: if hasAdminClaim();
    }


    // =========================================================
    // BOMBAS
    // =========================================================

    match /bombas/{bombaId} {

      allow read: if isAuthorized();

      // Adm2 pode realizar manutenção administrativa do documento.
      //
      // Usuário operacional só pode alterar os campos utilizados
      // pelos fluxos de abastecimento.
      allow update: if
        isAdm2()
        ||
        (
          isAuthorized()
          && changedOnly([
            'montanteAtual',
            'estoqueAtual',
            'ultimoAbastecimento',
            'ultimoFrentista'
          ])
        );

      allow create, delete: if false;
    }


    // =========================================================
    // CHAMADOS
    // =========================================================

    match /00-chamados/{chamadoId} {

      // O Flutter atualmente faz consultas globais para detectar
      // conflitos, inclusive de outro motorista.
      allow read: if isAuthorized();

      allow create: if isAuthorized();

      // Usuários podem movimentar somente os campos operacionais
      // do chamado.
      //
      // motorista/tipo/data não podem ser alterados.
      allow update: if
        isAuthorized()
        && changedOnly([
          'mntntInfrmd',
          'montanteInicial',
          'dfrncl',
          'status',
          'atualizadoEm',
          'updatedAt'
        ]);

      allow delete: if false;
    }


    // =========================================================
    // CONFIGURAÇÕES GLOBAIS
    // =========================================================

    match /configuracoes/{configId} {

      allow read: if isAuthorized();

      allow create, update: if
        isAdm2()
        && configId in [
          'checklist_saida',
          'checklist_saida_obrigatorios',
          'combustivel_verificacao'
        ]
        && request.resource.data.get(
          'atualizadoPor',
          request.auth.uid
        ) == request.auth.uid;

      allow delete: if false;
    }


    // =========================================================
    // NOTIFICAÇÕES
    // =========================================================

    match /notificacoes/{notificationId} {

      // Adm2 pode consultar qualquer notificação.
      //
      // O motorista pode executar GET da própria notificação,
      // necessário pelos fluxos transacionais.
      allow get: if
        isAdm2()
        ||
        (
          isAuthorized()
          && resource.data.get(
            'motoristaUid',
            ''
          ) == request.auth.uid
        );

      // Polling/listagem administrativa.
      allow list: if isAdm2();


      allow create: if
        isAuthorized()
        && request.resource.data.get(
          'motoristaUid',
          ''
        ) == request.auth.uid
        && request.resource.data.get(
          'destinatarioPerfil',
          'adm2'
        ) == 'adm2';


      // Preserva identidade/autoria da notificação.
      allow update: if
        (
          isAdm2()
          ||
          (
            isAuthorized()
            && resource.data.get(
              'motoristaUid',
              ''
            ) == request.auth.uid
          )
        )

        && request.resource.data.get(
          'motoristaUid',
          ''
        ) == resource.data.get(
          'motoristaUid',
          ''
        )

        && request.resource.data.get(
          'chamadoId',
          ''
        ) == resource.data.get(
          'chamadoId',
          ''
        )

        && request.resource.data.get(
          'tipo',
          ''
        ) == resource.data.get(
          'tipo',
          ''
        )

        && request.resource.data.get(
          'destinatarioPerfil',
          ''
        ) == resource.data.get(
          'destinatarioPerfil',
          ''
        );

      allow delete: if false;


      // -------------------------------------------------------
      // LEITURAS DE NOTIFICAÇÃO
      // -------------------------------------------------------

      match /leituras/{uid} {

        allow get: if
          isAdm2()
          && request.auth.uid == uid;

        allow list: if false;

        allow create, update: if
          isAdm2()
          && request.auth.uid == uid;

        allow delete: if false;
      }
    }


    // =========================================================
    // MANUTENÇÕES
    // =========================================================

    match /manutencoes/{manutencaoId} {

      allow read: if isAdm2() || hasAdminClaim();

      // Cadastro normal da manutenção.
      allow create: if isAdm2();

      // Editor genérico/destrutivo do React.
      allow update, delete: if hasAdminClaim();
    }


    // =========================================================
    // MANUTENÇÕES LEGADO
    // =========================================================

    match /manutencoes-legado/{manutencaoId} {

      allow read: if isAdm2() || hasAdminClaim();

      allow create: if false;

      allow update, delete: if hasAdminClaim();
    }


    // =========================================================
    // DEV OBRAS / LOCAIS
    // =========================================================

    match /dev_obras_locais/{documentId} {

      allow read: if isAdm2();

      allow create: if isAdm2();

      allow update, delete: if false;
    }


    // =========================================================
    // DEFAULT DENY
    // =========================================================

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Authentication and authorization profiles.
    function signedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return signedIn()
        ? request.auth.token.get('email', '').lower()
        : '';
    }

    function profileExists() {
      return signedIn()
        && authEmail() != ''
        && exists(
          /databases/$(database)/documents/00-autorizados/$(authEmail())
        );
    }

    function profile() {
      return get(
        /databases/$(database)/documents/00-autorizados/$(authEmail())
      ).data;
    }

    function isAuthorized() {
      return profileExists()
        && profile().get(
          'ativo',
          profile().get('active', true)
        ) == true;
    }

    function isAdm1() {
      return isAuthorized()
        && (
          profile().get('adm1', false) == true
          || profile().get('role', '') == 'adm1'
          || profile().get('perfil', '') == 'adm1'
        );
    }

    function isAdm2() {
      return isAuthorized()
        && (
          profile().get('adm2', false) == true
          || profile().get('role', '') == 'adm2'
          || profile().get('perfil', '') == 'adm2'
        );
    }

    function isAdmin() {
      return isAdm1() || isAdm2();
    }

    function hasAdminClaim() {
      return isAuthorized()
        && request.auth.token.get('admin', false) == true;
    }

    function isSelfEmail(email) {
      return signedIn() && authEmail() == email;
    }

    function changedOnly(fields) {
      return request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasOnly(fields);
    }

    function didNotChange(fields) {
      return !request.resource.data
        .diff(resource.data)
        .affectedKeys()
        .hasAny(fields);
    }

    function validNewDieselEntry() {
      return isAdm2()
        && request.resource.data.keys().hasAll([
          'data',
          'bombaId',
          'litrosComprados',
          'preco',
          'precoLitro',
          'lote',
          'responsavel',
          'estoqueAntes',
          'estoqueAposMovimento',
          'montanteSnapshot',
          'tipo'
        ])
        && request.resource.data.tipo == 'entrada'
        && request.resource.data.data is timestamp
        && request.resource.data.bombaId is string
        && request.resource.data.bombaId != ''
        && request.resource.data.litrosComprados is int
        && request.resource.data.litrosComprados > 0
        && request.resource.data.preco is number
        && request.resource.data.preco > 0
        && request.resource.data.precoLitro is number
        && request.resource.data.precoLitro > 0
        && (!request.resource.data.keys().hasAny(['schemaVersion'])
          || (request.resource.data.schemaVersion is int
            && request.resource.data.schemaVersion == 2
            && request.resource.data.preco is int
            && request.resource.data.precoLitro is int))
        && request.resource.data.lote is string
        && request.resource.data.lote != ''
        && request.resource.data.estoqueAntes is int
        && request.resource.data.estoqueAposMovimento is int
        && request.resource.data.montanteSnapshot is int
        && request.resource.data.responsavel is map
        && request.resource.data.responsavel.id is string
        && request.resource.data.responsavel.id == authEmail()
        && request.resource.data.responsavel.nome is string
        && request.resource.data.responsavel.nome == profile().get('nome', '')
        && request.resource.data.responsavel.nome != '';
    }

    function nonEmptyString(value) {
      return value is string && value != '';
    }

    function validSnapshot(value) {
      return value is map
        && nonEmptyString(value.uid)
        && nonEmptyString(value.nomeSnapshot);
    }

    function validV2ItemFrota(item) {
      return item is map
        && nonEmptyString(item.uid)
        && nonEmptyString(item.identificadorSnapshot)
        && (item.tipo == 'veiculo' || item.tipo == 'maquina')
        && (item.get('km', null) == null || item.get('km', null) is int)
        && (item.get('horimetro', null) == null || item.get('horimetro', null) is int)
        && (item.tipo == 'veiculo' ? item.get('horimetro', null) == null : item.get('km', null) == null);
    }

    function validV2Obra(obra) {
      return obra is map
        && nonEmptyString(obra.uid)
        && nonEmptyString(obra.nomeSnapshot)
        && (obra.get('localSnapshot', null) == null || obra.get('localSnapshot', null) is string);
    }

    function validV2OrigemPreco(origem) {
      return origem is map
        && nonEmptyString(origem.movimentoId)
        && (origem.get('lote', null) == null || origem.get('lote', null) is string)
        && origem.precoLitro is int
        && origem.precoLitro > 0;
    }

    function v2PumpCoherent() {
      // Kept as a named extension point: the emulator's expression budget
      // rejects the otherwise valid Flutter transaction when getAfter() is
      // combined with this legacy broad create rule. Pump field protection
      // remains enforced by the dedicated update rule below.
      return true;
    }

    function validV2FuelOutput() {
      return request.resource.data.schemaVersion is int
        && request.resource.data.schemaVersion == 2
        && request.resource.data.tipo == 'saida'
        && request.resource.data.data is timestamp
        && (request.resource.data.modalidadeAbastecimento == 'direto'
          || request.resource.data.modalidadeAbastecimento == 'galao')
        && request.resource.data.quantidadeAbastecida is int
        && request.resource.data.quantidadeAbastecida > 0
        && request.resource.data.valorAbastecimento is int
        && request.resource.data.valorAbastecimento >= 0
        && request.resource.data.estoqueAntes is int
        && request.resource.data.estoqueAposMovimento is int
        && request.resource.data.estoqueAposMovimento == request.resource.data.estoqueAntes - request.resource.data.quantidadeAbastecida
        && request.resource.data.montanteAntes is int
        && request.resource.data.montanteAposMovimento is int
        && request.resource.data.arla is int
        && nonEmptyString(request.resource.data.motivo)
        && validV2OrigemPreco(request.resource.data.origemPreco)
        && validSnapshot(request.resource.data.frentista)
        && validSnapshot(request.resource.data.paraQuem)
        && validSnapshot(request.resource.data.autorLancamento)
        && request.resource.data.autorLancamento.uid == request.auth.uid
        && validV2ItemFrota(request.resource.data.itemFrota)
        && validV2Obra(request.resource.data.obra)
        && (request.resource.data.get('observacao', null) == null || request.resource.data.get('observacao', null) is string)
        && (request.resource.data.get('semKm', null) == null || request.resource.data.get('semKm', null) is string);
    }


    // Authorization profiles are maintained by the Admin SDK backend.
    match /00-autorizados/{email} {
      allow get: if isSelfEmail(email) || isAdm2();
      allow list: if isAdm1() || isAdm2();
      allow create, update, delete: if false;

      match /fcmTokens/{tokenId} {
        allow read: if false;

        allow create, update: if
          isSelfEmail(email)
          && isAuthorized()
          && request.resource.data.get('token', tokenId) == tokenId;

        allow delete: if false;
      }
    }


    match /Versionamento/app {
      allow read: if signedIn();
      allow write: if false;
    }


    // Legacy React profile. Authorization fields are immutable.
    match /users/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;

      allow update: if
        signedIn()
        && request.auth.uid == uid
        && didNotChange([
          'role',
          'perfil',
          'adm1',
          'adm2',
          'admin',
          'permissions'
        ]);

      allow create, delete: if false;
    }


    match /veiculos/{veiculoId} {
      allow read: if isAuthorized();
      allow create: if isAdm2();

      // Operational users may only update shared mileage state.
      allow update: if
        isAdm2()
        || (
          isAuthorized()
          && changedOnly([
            'quilometragemUltima',
            'dataUltimaAtualizacao'
          ])
        );

      allow delete: if false;
    }


    match /01-placas/{placaId} {
      allow read, create: if isAdm2();
      allow update, delete: if false;
    }


    match /obras/{obraId} {
      allow read: if isAuthorized();
      allow create, update, delete: if isAdm2();
    }


    match /motoristas/{motoristaId} {
      allow read: if isAuthorized();
      allow write: if false;
    }

    match /motivos/{motivoId} {
      allow read: if isAuthorized();
      allow write: if false;
    }


    match /notas-categorias/{documentId} {
      allow read: if isAdm2();
      allow create, update, delete: if isAdm2();
    }

    match /notas-fornecedores/{documentId} {
      allow read: if isAdm2();
      allow create, update, delete: if isAdm2();
    }

    match /notas-fornecedores-numeros/{documentId} {
      allow read: if isAdm2();
      allow create, update, delete: if isAdm2();
    }

    match /app-metadata/notas-fornecedores-numero {
      allow read: if isAdm2();
      allow create, update: if isAdm2();
      allow delete: if false;
    }


    match /atividades/{atividadeId} {
      // Both clients perform broad administrative/operational listings.
      allow read: if isAuthorized();

      // Extra fields are allowed; only identity and authorship are enforced.
      allow create: if
        isAuthorized()
        && request.resource.data.get(
          'criadoPorUid',
          request.auth.uid
        ) == request.auth.uid
        && (
          isAdmin()
          || request.resource.data.get(
            'motoristaUid',
            request.auth.uid
          ) == request.auth.uid
        );

      // Activity history is immutable.
      allow update, delete: if false;

      match /checklist_saida/{itemId} {
        allow read: if isAuthorized();

        allow create: if
          isAuthorized()
          && request.resource.data.get(
            'criadoPorUid',
            request.auth.uid
          ) == request.auth.uid;

        allow update, delete: if false;
      }

      match /checklist_chegada/{itemId} {
        allow read: if isAuthorized();

        // Catalog version and payload shape are application concerns.
        allow create: if
          isAuthorized()
          && request.resource.data.get(
            'criadoPorUid',
            request.auth.uid
          ) == request.auth.uid;

        allow update, delete: if false;
      }
    }


    match /03-combustivel/{registroId} {
      // Current React and Flutter flows require broad reads.
      allow read: if isAuthorized();

      // Legacy records may omit UID fields. If present, authorship cannot be
      // forged. Admin profiles may register for another motoristaUid.
      allow create: if
        isAuthorized()
        && (
          request.resource.data.get('tipo', '') != 'entrada'
          || validNewDieselEntry()
        )
        && (
          !(request.resource.data.get('schemaVersion', 0) == 2 && request.resource.data.get('tipo', '') == 'saida')
          || validV2FuelOutput()
        )
        && (
          (request.resource.data.get('schemaVersion', 0) == 2 && request.resource.data.get('tipo', '') == 'saida')
          || (
            (request.resource.data.get('motivo', '') != 'Abastecimento de Diesel' || isAdm2())
            && request.resource.data.get('uid', request.auth.uid) == request.auth.uid
            && request.resource.data.get('criadoPorUid', request.auth.uid) == request.auth.uid
            && (isAdmin() || request.resource.data.get('motoristaUid', request.auth.uid) == request.auth.uid)
          )
        );

      allow update, delete: if hasAdminClaim();
    }


    match /bombas/{bombaId} {
      allow read: if isAuthorized();

      // Operational users modify only the shared fuel state.
      allow update: if
        isAdm2()
        || (
          isAuthorized()
          && changedOnly([
            'montanteAtual',
            'estoqueAtual',
            'ultimoAbastecimento',
            'ultimoFrentista'
          ])
        );

      allow create, delete: if false;
    }


    match /00-chamados/{chamadoId} {
      // Flutter intentionally queries conflicts across drivers.
      allow read: if isAuthorized();

      allow create: if
        isAuthorized()
        && request.resource.data.get(
          'criadoPorUid',
          request.auth.uid
        ) == request.auth.uid
        && (
          isAdmin()
          || request.resource.data.get(
            'motoristaUid',
            request.auth.uid
          ) == request.auth.uid
        );

      // New operational fields are allowed; identity/origin is immutable.
      allow update: if
        isAuthorized()
        && didNotChange([
          'motorista',
          'motoristaUid',
          'criadoPorUid',
          'tipo',
          'data'
        ]);

      allow delete: if false;
    }


    match /configuracoes/{configId} {
      allow read: if isAuthorized();
      allow create, update: if isAdm2();
      allow delete: if false;
    }


    match /notificacoes/{notificationId} {
      allow get: if
        isAdm2()
        || (
          isAuthorized()
          && resource.data.get('motoristaUid', '') == request.auth.uid
        );

      allow list: if isAdm2();

      allow create: if
        isAuthorized()
        && request.resource.data.get('motoristaUid', '') == request.auth.uid;

      allow update: if
        (
          isAdm2()
          || (
            isAuthorized()
            && resource.data.get('motoristaUid', '') == request.auth.uid
          )
        )
        && didNotChange([
          'motoristaUid',
          'chamadoId',
          'tipo',
          'destinatarioPerfil'
        ]);

      allow delete: if false;

      match /leituras/{uid} {
        allow get: if isAdm2() && request.auth.uid == uid;
        allow list: if false;
        allow create, update: if isAdm2() && request.auth.uid == uid;
        allow delete: if false;
      }
    }


    match /manutencoes/{manutencaoId} {
      allow read: if isAdm2() || hasAdminClaim();
      allow create: if isAdm2();
      allow update, delete: if hasAdminClaim();
    }

    match /manutencoes-legado/{manutencaoId} {
      allow read: if isAdm2() || hasAdminClaim();
      allow create: if false;
      allow update, delete: if hasAdminClaim();
    }


    match /dev_obras_locais/{documentId} {
      allow read, create: if isAdm2();
      allow update, delete: if false;
    }


    // Default deny for every undeclared collection and subcollection.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';

// Fonte única das Rules de Storage do projeto app-motor-api (WEB e app Flutter). Base: as Rules publicadas em
// produção em 2026-10-20, com autorização por funcionarios/{uid} e 00-autorizados como fallback de transição.
// Contrato no Manuscript (01_FIRESTORE/03_RULES.md). Não publicar sem a revisão do app Flutter.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function authEmail() {
      return request.auth.token.get('email', '').lower();
    }

    function employeePath() {
      return /databases/(default)/documents/funcionarios/$(request.auth.uid);
    }

    function legacyPath() {
      return /databases/(default)/documents/00-autorizados/$(authEmail());
    }

    function legacyProfile() {
      return firestore.get(legacyPath()).data;
    }

    function isAuthorized() {
      return signedIn()
        && (
          firestore.exists(employeePath())
            ? firestore.get(employeePath()).data.get('ativo', false) == true
            : authEmail() != ''
              && firestore.exists(legacyPath())
              && legacyProfile().get('ativo', legacyProfile().get('active', true)) == true
        );
    }

    function isChecklistVehicleFlow(fluxo) {
      return fluxo in ['saidas', 'chegadas'];
    }

    function isChecklistImage() {
      return request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
    }

    function isChecklistPhotoFile(arquivo) {
      return arquivo.matches(
        '^[A-Za-z0-9_]+_[0-9]{8}_[0-9]{6}(_[0-9]+)?\\.(jpg|jpeg|png|webp)$'
      );
    }

    // Checklist photos (Saída/Chegada). The app's upload code exists but is not wired yet; the WEB only downloads.
    match /checklists/{fluxo}/{atividadeId}/{arquivo} {
      allow read: if isAuthorized() && isChecklistVehicleFlow(fluxo);

      allow create: if isAuthorized()
        && isChecklistVehicleFlow(fluxo)
        && isChecklistImage()
        && isChecklistPhotoFile(arquivo);

      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function userDocSnap() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid));
    }

    function userData() {
      return userDocSnap().data;
    }

    function isAdmin() {
      return isSignedIn()
        && userData() != null
        && userData().role == "admin";
    }

    function hasObra(obraId) {
      return isSignedIn()
        && userData() != null
        && (obraId is string)
        && (obraId != "")
        && ('obras' in userData())
        && (userData().obras is list)
        && (obraId in userData().obras);
    }

    function isAllowedContentType() {
      return request.resource != null
        && (
          request.resource.contentType.matches('image/.*')
          || request.resource.contentType == 'application/pdf'
        );
    }

    function isAllowedSize() {
      return request.resource != null
        && request.resource.size < 20 * 1024 * 1024;
    }

    match /obras/{obraId}/{subpath=**} {
      allow read: if isAdmin() || hasObra(obraId);
      allow write: if (isAdmin() || hasObra(obraId)) && isAllowedSize() && isAllowedContentType();
    }
  }
}
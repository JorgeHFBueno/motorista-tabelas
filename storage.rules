rules_version = '2';

// Fonte única das Rules de Storage do projeto app-motor-api (WEB e app Flutter). Autorização só por
// funcionarios/{uid}. Contrato no Manuscript (01_FIRESTORE/03_RULES.md).
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function employeePath() {
      return /databases/(default)/documents/funcionarios/$(request.auth.uid);
    }

    function isAuthorized() {
      return signedIn()
        && firestore.exists(employeePath())
        && firestore.get(employeePath()).data.get('ativo', false) == true;
    }

    function hasPerfil(perfil) {
      return isAuthorized()
        && firestore.get(employeePath()).data.get('perfis', {}).get(perfil, false) == true;
    }

    // WEB areas, the same as nivelArea in firestore.rules (Manuscript funcionarios.md, 2026-11-16): `areas`; a missing
    // area = no access; adm2 edits every area. One read of the profile.
    function nivelArea(a) {
      let f = isAuthorized() ? firestore.get(employeePath()).data : {};
      let p = f.get('perfis', {});
      return p.get('adm2', false) == true ? 'editar' : f.get('areas', {}).get(a, '');
    }

    // Sees the WEB area (reads): 'ver' or 'editar'; adm2 sees every area.
    function veArea(a) {
      return nivelArea(a) in ['ver', 'editar'];
    }

    // Edits the WEB area (writes, corrections, deletions); adm2 edits every area.
    function editaArea(a) {
      return nivelArea(a) == 'editar';
    }

    // Mechanic checklist (app): mechanics and adm2 send the photos.
    function isChecklistV2User() {
      return hasPerfil('mecanico') || hasPerfil('adm2');
    }

    // Reading them: the checklist (app mecanico) and the WEB Mecânica area, adm2 included.
    function isChecklistV2Reader() {
      return hasPerfil('mecanico') || veArea('mecanica');
    }

    // The driver reads photos and signature of the checklists made for them (motoristaOperador.uid, as in firestore.rules).
    function isChecklistV2Driver(checklistId) {
      return isAuthorized()
        && firestore.get(/databases/(default)/documents/checklists-v2/$(checklistId)).data.get('motoristaOperador', {}).get('uid', '') == request.auth.uid;
    }

    // Writing over an existing object is evaluated as create; resource == null keeps files from being replaced.
    function isNewObject() {
      return resource == null;
    }

    function isChecklistV2Jpeg(maxBytes, arquivo) {
      return isNewObject()
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size <= maxBytes
        && arquivo.matches('^[a-z0-9_]+_[0-9]+\\.jpg$');
    }

    function isChecklistVehicleFlow(fluxo) {
      return fluxo in ['saidas', 'chegadas'];
    }

    function isChecklistImage() {
      return request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
    }

    function isChecklistPhotoFile(arquivo) {
      return arquivo.matches(
        '^[A-Za-z0-9_]+_[0-9]{8}_[0-9]{6}(_[0-9]+)?\\.(jpg|jpeg|png|webp)$'
      );
    }

    // Checklist photos (Saída/Chegada). The app's upload code exists but is not wired yet; the WEB only downloads.
    match /checklists/{fluxo}/{atividadeId}/{arquivo} {
      allow read: if isAuthorized() && isChecklistVehicleFlow(fluxo);

      allow create: if isAuthorized()
        && isNewObject()
        && isChecklistVehicleFlow(fluxo)
        && isChecklistImage()
        && isChecklistPhotoFile(arquivo);

      allow update, delete: if false;
    }

    // Mechanic checklist photos <itemId>_<n>.jpg (the app keeps them under 1 MB) and thumbnails. The app checks
    // whether a file already exists before re-sending and downloads photos to the gallery; never overwritten.
    match /checklists-v2/{checklistId}/{arquivo} {
      allow read: if isChecklistV2Reader() || isChecklistV2Driver(checklistId);
      allow create: if isChecklistV2User() && isChecklistV2Jpeg(2 * 1024 * 1024, arquivo);
      allow update, delete: if false;
    }

    match /checklists-v2/{checklistId}/miniaturas/{arquivo} {
      allow read: if isChecklistV2Reader() || isChecklistV2Driver(checklistId);
      allow create: if isChecklistV2User() && isChecklistV2Jpeg(200 * 1024, arquivo);
      allow update, delete: if false;
    }

    // Mechanic maintenance photos <itemId>_<n>.jpg and thumbnails (app, Manuscript manutencoes-v2.md): itemId is the
    // app's 20-character id (upper and lower case) and n is unique per photo, not its order. Same users as the
    // checklist; never overwritten nor deleted.
    function isManutencaoV2Jpeg(maxBytes, arquivo) {
      return isNewObject()
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size <= maxBytes
        && arquivo.matches('^[A-Za-z0-9]+_[0-9]+\\.jpg$');
    }

    match /manutencoes-v2/{manutencaoId}/{arquivo} {
      allow read: if isChecklistV2Reader();
      allow create: if isChecklistV2User() && isManutencaoV2Jpeg(2 * 1024 * 1024, arquivo);
      allow update, delete: if false;
    }

    match /manutencoes-v2/{manutencaoId}/miniaturas/{arquivo} {
      allow read: if isChecklistV2Reader();
      allow create: if isChecklistV2User() && isManutencaoV2Jpeg(200 * 1024, arquivo);
      allow update, delete: if false;
    }

    // Friday attachments: friday/{quadroId}/{itemId}/{anexoId}-{nome}. Same access as the board in Firestore
    // (friday area or adm2; a restricted board only for its "acesso" list, adm2 always), up to 25 MB, never
    // overwritten; deleted together with the attachment record.
    function isFridayUser() {
      return veArea('friday');
    }

    function fridayBoardAllowed(quadroId) {
      let q = firestore.get(/databases/(default)/documents/friday-quadros/$(quadroId)).data;
      return isFridayUser()
        && (hasPerfil('adm2') || q.restrito != 1 || request.auth.uid in q.acesso);
    }

    match /friday/{quadroId}/{itemId}/{arquivo} {
      allow read, delete: if fridayBoardAllowed(quadroId);
      allow create: if fridayBoardAllowed(quadroId)
        && isNewObject()
        && request.resource.size <= 25 * 1024 * 1024;
      allow update: if false;
    }

    // Comercial (2026-11-23): arquivos dos negócios (Referências, Projeto pronto e outros), comercial/negocios/{negocioId}/{arquivo}.
    // Área comercial (ver lê, editar envia e apaga; o mesmo de comercial-negocios no Firestore), até 25 MB, sem sobrescrever.
    match /comercial/negocios/{negocioId}/{arquivo} {
      allow read: if veArea('comercial');
      allow delete: if editaArea('comercial');
      allow create: if editaArea('comercial')
        && isNewObject()
        && request.resource.size <= 25 * 1024 * 1024;
      allow update: if false;
    }

    // ERP, Aprovar página (2026-11-26): imagens da decisão de cada página (rabiscos do Canvas, prints),
    // erp/aprovacoes/{paginaId}/{arquivo}. Área erp (ver lê, editar envia e apaga; o mesmo de erp-aprovacoes no Firestore),
    // só imagem, até 10 MB, sem sobrescrever.
    match /erp/aprovacoes/{paginaId}/{arquivo} {
      allow read: if veArea('erp');
      allow delete: if editaArea('erp');
      allow create: if editaArea('erp')
        && isNewObject()
        && request.resource.contentType.matches('image/.*')
        && request.resource.size <= 10 * 1024 * 1024;
      allow update: if false;
    }

    // Cronograma Logístico: arquivos das observações, logistica/observacoes/{observacaoId}/{arquivo}. Logística area
    // (ver reads, editar sends and deletes; the same as logistica-observacoes in Firestore), up to 25 MB, never
    // overwritten; deleted together with the observation or the programação.
    match /logistica/observacoes/{observacaoId}/{arquivo} {
      allow read: if veArea('logistica');
      allow delete: if editaArea('logistica');
      allow create: if editaArea('logistica')
        && isNewObject()
        && request.resource.size <= 25 * 1024 * 1024;
      allow update: if false;
    }

    // Cronograma Logístico: PDF da nota de uma programação, logistica/notas/{programacaoId}/{arquivo}. The same area,
    // PDF only, up to 25 MB, never overwritten (a new note is a new file); deleted when the note is replaced or removed
    // and with the programação.
    match /logistica/notas/{programacaoId}/{arquivo} {
      allow read: if veArea('logistica');
      allow delete: if editaArea('logistica');
      allow create: if editaArea('logistica')
        && isNewObject()
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow update: if false;
    }

    // Detalhe da obra (/engenharia/obras/:id): PDFs dos pré-fabricados dos LOTEs, obras/pre-fabricados/{obraId}/{arquivo}
    // (2026-11-24). Área engenharia (ver lê, editar envia e apaga; o mesmo de obras-pre-fabricados-pdfs no Firestore),
    // só PDF, até 25 MB, sem sobrescrever (substituir envia um arquivo novo e apaga o antigo).
    match /obras/pre-fabricados/{obraId}/{arquivo} {
      allow read: if veArea('engenharia');
      allow delete: if editaArea('engenharia');
      allow create: if editaArea('engenharia')
        && isNewObject()
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
      allow update: if false;
    }

    // ================================================================ client portal (Manuscript portal.md)

    // Portal clients live in users/{uid} (not funcionarios) and see the files of the contracts of their CNPJ/CPF.
    // The client check runs first, so each request reads at most two Firestore documents. Nothing is overwritten or
    // deleted (the trash is the excluidoEm field in Firestore).
    function clientePath() {
      return /databases/(default)/documents/users/$(request.auth.uid);
    }

    function isPortalClienteAtivo() {
      return signedIn()
        && firestore.exists(clientePath())
        && firestore.get(clientePath()).data.get('ativo', false) == true;
    }

    // The signed-in active client represents the CNPJ/CPF of the given portal document (contract or ticket).
    function isPortalClienteDe(colecao, id) {
      let docPath = /databases/(default)/documents/$(colecao)/$(id);
      return isPortalClienteAtivo()
        && firestore.exists(docPath)
        && firestore.get(docPath).data.get('clienteDocumento', '')
          in firestore.get(clientePath()).data.get('documentos', []);
    }

    function isPortalArquivo(maxBytes) {
      return isNewObject() && request.resource.size <= maxBytes;
    }

    function isPortalPdfOuImagem(maxBytes) {
      return isPortalArquivo(maxBytes)
        && (request.resource.contentType == 'application/pdf' || request.resource.contentType.matches('image/.*'));
    }

    match /portal/obras/{obraId}/documentos/{documentoId}/{arquivo} {
      allow read: if isPortalClienteDe('portal-obras', obraId) || veArea('portal');
      allow create: if editaArea('portal') && isPortalArquivo(50 * 1024 * 1024);
      allow update, delete: if false;
    }

    match /portal/obras/{obraId}/fotos/{fotoId}/{arquivo} {
      allow read: if isPortalClienteDe('portal-obras', obraId) || veArea('portal');
      allow create: if editaArea('portal')
        && isPortalArquivo(20 * 1024 * 1024)
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    match /portal/obras/{obraId}/parcelas/{parcelaId}/boleto/{arquivo} {
      allow read: if isPortalClienteDe('portal-obras', obraId) || veArea('portal');
      allow create: if editaArea('portal') && isPortalPdfOuImagem(10 * 1024 * 1024);
      allow update, delete: if false;
    }

    match /portal/obras/{obraId}/parcelas/{parcelaId}/comprovante/{arquivo} {
      allow read: if isPortalClienteDe('portal-obras', obraId) || veArea('portal');
      allow create: if (isPortalClienteDe('portal-obras', obraId) || editaArea('portal'))
        && isPortalPdfOuImagem(10 * 1024 * 1024);
      allow update, delete: if false;
    }

    match /portal/atendimentos/{atendimentoId}/{mensagemId}/{arquivo} {
      allow read: if isPortalClienteDe('portal-atendimentos', atendimentoId) || veArea('portal');
      allow create: if (isPortalClienteDe('portal-atendimentos', atendimentoId) || editaArea('portal'))
        && isPortalArquivo(10 * 1024 * 1024);
      allow update, delete: if false;
    }

    match /portal/noticias/{noticiaId}/{arquivo} {
      allow read: if isPortalClienteAtivo() || veArea('portal');
      allow create: if editaArea('portal')
        && isPortalArquivo(10 * 1024 * 1024)
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

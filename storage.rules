rules_version = '2';

// Fonte única das Rules de Storage do projeto app-motor-api (WEB e app Flutter). Autorização só por
// funcionarios/{uid}. Contrato no Manuscript (01_FIRESTORE/03_RULES.md).
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function employeePath() {
      return /databases/(default)/documents/funcionarios/$(request.auth.uid);
    }

    function isAuthorized() {
      return signedIn()
        && firestore.exists(employeePath())
        && firestore.get(employeePath()).data.get('ativo', false) == true;
    }

    function hasPerfil(perfil) {
      return isAuthorized()
        && firestore.get(employeePath()).data.get('perfis', {}).get(perfil, false) == true;
    }

    // WEB area open to adm2 and to up to two credentials (repeat the key to use only one); one read of the profile.
    function temArea(a, b) {
      return isAuthorized()
        && (
          firestore.get(employeePath()).data.get('perfis', {}).get('adm2', false) == true
          || firestore.get(employeePath()).data.get('perfis', {}).get(a, false) == true
          || firestore.get(employeePath()).data.get('perfis', {}).get(b, false) == true
        );
    }

    // Mechanic checklist (app): mechanics and adm2 send the photos.
    function isChecklistV2User() {
      return hasPerfil('mecanico') || hasPerfil('adm2');
    }

    // Reading them: the checklist (mecanico) and Frota on the WEB (mecanico, logistica), adm2 included.
    function isChecklistV2Reader() {
      return temArea('mecanico', 'logistica');
    }

    // Client portal, team side (WEB /portal-cliente): engenharia, escritorio or adm2.
    function isEquipePortal() {
      return temArea('engenharia', 'escritorio');
    }

    // Writing over an existing object is evaluated as create; resource == null keeps files from being replaced.
    function isNewObject() {
      return resource == null;
    }

    function isChecklistV2Jpeg(maxBytes, arquivo) {
      return isNewObject()
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size <= maxBytes
        && arquivo.matches('^[a-z0-9_]+_[0-9]+\\.jpg$');
    }

    function isChecklistVehicleFlow(fluxo) {
      return fluxo in ['saidas', 'chegadas'];
    }

    function isChecklistImage() {
      return request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
    }

    function isChecklistPhotoFile(arquivo) {
      return arquivo.matches(
        '^[A-Za-z0-9_]+_[0-9]{8}_[0-9]{6}(_[0-9]+)?\\.(jpg|jpeg|png|webp)$'
      );
    }

    // Checklist photos (Saída/Chegada). The app's upload code exists but is not wired yet; the WEB only downloads.
    match /checklists/{fluxo}/{atividadeId}/{arquivo} {
      allow read: if isAuthorized() && isChecklistVehicleFlow(fluxo);

      allow create: if isAuthorized()
        && isNewObject()
        && isChecklistVehicleFlow(fluxo)
        && isChecklistImage()
        && isChecklistPhotoFile(arquivo);

      allow update, delete: if false;
    }

    // Mechanic checklist photos <itemId>_<n>.jpg (the app keeps them under 1 MB) and thumbnails. The app checks
    // whether a file already exists before re-sending and downloads photos to the gallery; never overwritten.
    match /checklists-v2/{checklistId}/{arquivo} {
      allow read: if isChecklistV2Reader();
      allow create: if isChecklistV2User() && isChecklistV2Jpeg(2 * 1024 * 1024, arquivo);
      allow update, delete: if false;
    }

    match /checklists-v2/{checklistId}/miniaturas/{arquivo} {
      allow read: if isChecklistV2Reader();
      allow create: if isChecklistV2User() && isChecklistV2Jpeg(200 * 1024, arquivo);
      allow update, delete: if false;
    }

    // Friday attachments: friday/{quadroId}/{itemId}/{anexoId}-{nome}. Same access as the board in Firestore
    // (escritorio or adm2; a restricted board only for its "acesso" list, adm2 always), up to 25 MB, never
    // overwritten; deleted together with the attachment record.
    function isFridayUser() {
      return hasPerfil('escritorio') || hasPerfil('adm2');
    }

    function fridayBoardAllowed(quadroId) {
      let q = firestore.get(/databases/(default)/documents/friday-quadros/$(quadroId)).data;
      return isFridayUser()
        && (hasPerfil('adm2') || q.restrito != 1 || request.auth.uid in q.acesso);
    }

    match /friday/{quadroId}/{itemId}/{arquivo} {
      allow read, delete: if fridayBoardAllowed(quadroId);
      allow create: if fridayBoardAllowed(quadroId)
        && isNewObject()
        && request.resource.size <= 25 * 1024 * 1024;
      allow update: if false;
    }

    // Cronograma Logístico: arquivos das observações, logistica/observacoes/{observacaoId}/{arquivo}. logistica,
    // mecanico or adm2 (the same as logistica-observacoes in Firestore), up to 25 MB, never overwritten; deleted
    // together with the observation or the programação.
    match /logistica/observacoes/{observacaoId}/{arquivo} {
      allow read, delete: if temArea('logistica', 'mecanico');
      allow create: if temArea('logistica', 'mecanico')
        && isNewObject()
        && request.resource.size <= 25 * 1024 * 1024;
      allow update: if false;
    }

    // ================================================================ client portal (Manuscript portal.md)

    // Portal clients live in users/{uid} (not funcionarios) and see the files of the contracts of their CNPJ/CPF.
    // The client check runs first, so each request reads at most two Firestore documents. Nothing is overwritten or
    // deleted (the trash is the excluidoEm field in Firestore).
    function clientePath() {
      return /databases/(default)/documents/users/$(request.auth.uid);
    }

    function isPortalClienteAtivo() {
      return signedIn()
        && firestore.exists(clientePath())
        && firestore.get(clientePath()).data.get('ativo', false) == true;
    }

    // The signed-in active client represents the CNPJ/CPF of the given portal document (contract or ticket).
    function isPortalClienteDe(colecao, id) {
      let docPath = /databases/(default)/documents/$(colecao)/$(id);
      return isPortalClienteAtivo()
        && firestore.exists(docPath)
        && firestore.get(docPath).data.get('clienteDocumento', '')
          in firestore.get(clientePath()).data.get('documentos', []);
    }

    function isPortalArquivo(maxBytes) {
      return isNewObject() && request.resource.size <= maxBytes;
    }

    function isPortalPdfOuImagem(maxBytes) {
      return isPortalArquivo(maxBytes)
        && (request.resource.contentType == 'application/pdf' || request.resource.contentType.matches('image/.*'));
    }

    match /portal/obras/{obraId}/documentos/{documentoId}/{arquivo} {
      allow read: if isPortalClienteDe('portal-obras', obraId) || isEquipePortal();
      allow create: if isEquipePortal() && isPortalArquivo(50 * 1024 * 1024);
      allow update, delete: if false;
    }

    match /portal/obras/{obraId}/fotos/{fotoId}/{arquivo} {
      allow read: if isPortalClienteDe('portal-obras', obraId) || isEquipePortal();
      allow create: if isEquipePortal()
        && isPortalArquivo(20 * 1024 * 1024)
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    match /portal/obras/{obraId}/parcelas/{parcelaId}/boleto/{arquivo} {
      allow read: if isPortalClienteDe('portal-obras', obraId) || isEquipePortal();
      allow create: if isEquipePortal() && isPortalPdfOuImagem(10 * 1024 * 1024);
      allow update, delete: if false;
    }

    match /portal/obras/{obraId}/parcelas/{parcelaId}/comprovante/{arquivo} {
      allow read: if isPortalClienteDe('portal-obras', obraId) || isEquipePortal();
      allow create: if (isPortalClienteDe('portal-obras', obraId) || isEquipePortal())
        && isPortalPdfOuImagem(10 * 1024 * 1024);
      allow update, delete: if false;
    }

    match /portal/atendimentos/{atendimentoId}/{mensagemId}/{arquivo} {
      allow read: if isPortalClienteDe('portal-atendimentos', atendimentoId) || isEquipePortal();
      allow create: if (isPortalClienteDe('portal-atendimentos', atendimentoId) || isEquipePortal())
        && isPortalArquivo(10 * 1024 * 1024);
      allow update, delete: if false;
    }

    match /portal/noticias/{noticiaId}/{arquivo} {
      allow read: if isPortalClienteAtivo() || isEquipePortal();
      allow create: if isEquipePortal()
        && isPortalArquivo(10 * 1024 * 1024)
        && request.resource.contentType.matches('image/.*');
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';

// Fonte única das Rules de Storage do projeto app-motor-api (WEB e app Flutter). Autorização só por
// funcionarios/{uid}. Contrato no Manuscript (01_FIRESTORE/03_RULES.md).
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function employeePath() {
      return /databases/(default)/documents/funcionarios/$(request.auth.uid);
    }

    function isAuthorized() {
      return signedIn()
        && firestore.exists(employeePath())
        && firestore.get(employeePath()).data.get('ativo', false) == true;
    }

    function hasPerfil(perfil) {
      return isAuthorized()
        && firestore.get(employeePath()).data.get('perfis', {}).get(perfil, false) == true;
    }

    // Mechanic checklist (app): mechanics and adm2.
    function isChecklistV2User() {
      return hasPerfil('mecanico') || hasPerfil('adm2');
    }

    // Writing over an existing object is evaluated as create; resource == null keeps files from being replaced.
    function isNewObject() {
      return resource == null;
    }

    function isChecklistV2Jpeg(maxBytes, arquivo) {
      return isNewObject()
        && request.resource.contentType == 'image/jpeg'
        && request.resource.size <= maxBytes
        && arquivo.matches('^[a-z0-9_]+_[0-9]+\\.jpg$');
    }

    function isChecklistVehicleFlow(fluxo) {
      return fluxo in ['saidas', 'chegadas'];
    }

    function isChecklistImage() {
      return request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType in [
          'image/jpeg',
          'image/png',
          'image/webp'
        ];
    }

    function isChecklistPhotoFile(arquivo) {
      return arquivo.matches(
        '^[A-Za-z0-9_]+_[0-9]{8}_[0-9]{6}(_[0-9]+)?\\.(jpg|jpeg|png|webp)$'
      );
    }

    // Checklist photos (Saída/Chegada). The app's upload code exists but is not wired yet; the WEB only downloads.
    match /checklists/{fluxo}/{atividadeId}/{arquivo} {
      allow read: if isAuthorized() && isChecklistVehicleFlow(fluxo);

      allow create: if isAuthorized()
        && isNewObject()
        && isChecklistVehicleFlow(fluxo)
        && isChecklistImage()
        && isChecklistPhotoFile(arquivo);

      allow update, delete: if false;
    }

    // Mechanic checklist photos <itemId>_<n>.jpg (the app keeps them under 1 MB) and thumbnails. The app checks
    // whether a file already exists before re-sending and downloads photos to the gallery; never overwritten.
    match /checklists-v2/{checklistId}/{arquivo} {
      allow read: if isChecklistV2User();
      allow create: if isChecklistV2User() && isChecklistV2Jpeg(2 * 1024 * 1024, arquivo);
      allow update, delete: if false;
    }

    match /checklists-v2/{checklistId}/miniaturas/{arquivo} {
      allow read: if isChecklistV2User();
      allow create: if isChecklistV2User() && isChecklistV2Jpeg(200 * 1024, arquivo);
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
